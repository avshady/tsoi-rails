<% content_for :title, "Import Post" %>

<% inp = "width:100%; padding:9px 12px; border:1px solid rgba(0,0,0,0.15); border-radius:4px; font-size:14px; box-sizing:border-box; font-family:inherit;" %>
<% lbl = "display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; opacity:0.55; margin-bottom:6px;" %>
<% hint = "font-size:11px; opacity:0.45; margin:6px 0 0;" %>

<div style="margin-bottom:2rem;">
  <%= link_to "← Blog Posts", admin_posts_path, style:"font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#999; text-decoration:none;" %>
  <h1 style="font-size:1.5rem; font-weight:700; margin:0.75rem 0 0;">Import from pipeline</h1>
</div>

<% if @error.present? %>
  <div style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; padding:12px 16px; margin-bottom:1.5rem; border-radius:4px; font-size:13px;">
    <strong>Import failed:</strong> <%= @error %>
  </div>
<% end %>

<%= form_with url: admin_import_posts_path, method: :post, multipart: true, local: true do %>
  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:1.75rem; margin-bottom:1.5rem;">
    <div style="margin-bottom:1.5rem;">
      <label for="package" style="<%= lbl %>">Package file (.md)</label>
      <input type="file" name="package" id="package" accept=".md,text/markdown,text/plain" style="font-size:13px;">
      <p style="<%= hint %>">The assembler's <code>&lt;slug&gt;-admin-upload.md</code> file.</p>
    </div>

    <div>
      <label for="images" style="<%= lbl %>">Images (1–3: cover &amp; infographics)</label>
      <input type="file" name="images[]" id="images" multiple accept="image/png,image/jpeg,image/webp,image/gif" style="font-size:13px;">
      <p style="<%= hint %>">Upload the renamed image files from the package. Their filenames must match the names in the package's <strong>COVER IMAGE</strong> and <strong>IMAGES TO UPLOAD</strong> sections. JPG, PNG, WebP or GIF, up to 10 MB each.</p>
    </div>
  </div>

  <div style="background:#f8fafc; border:1px solid rgba(0,0,0,0.08); padding:14px 16px; margin-bottom:1.5rem; border-radius:4px; font-size:12px; opacity:0.75; line-height:1.6;">
    The import always creates a <strong>draft</strong> — it never publishes, whatever the package says. You'll land on the Edit page with every field filled in, where you can preview and publish when ready.
  </div>

  <div style="display:flex; align-items:center; gap:1rem;">
    <%= submit_tag "Import as draft", style:"background:#821E25; color:white; padding:11px 28px; font-size:13px; font-weight:700; border:none; border-radius:4px; cursor:pointer;" %>
    <%= link_to "Cancel", admin_posts_path, style:"color:#999; font-size:13px; font-weight:600; text-decoration:none;" %>
  </div>
<% end %>
