<% inp = "width:100%; padding:9px 12px; border:1px solid rgba(0,0,0,0.15); border-radius:4px; font-size:14px; box-sizing:border-box; font-family:inherit;" %>
<% lbl = "display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; opacity:0.55; margin-bottom:6px;" %>

<% hint = "font-size:11px; opacity:0.45; margin:6px 0 0;" %>
<% category_options = Post::CATEGORIES.map { |c| [ c, c ] } %>
<% if post.category.present? && !Post::CATEGORIES.include?(post.category) %>
  <% category_options.unshift([ "#{post.category} (old category)", post.category ]) %>
<% end %>

<%= form_with model: [:admin, post], local: true do |f| %>
  <% if post.errors.any? %>
    <div style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; padding:12px 16px; margin-bottom:1.5rem; border-radius:4px; font-size:13px;">
      <%= post.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:1.75rem; margin-bottom:1.5rem;">
    <div style="margin-bottom:1.25rem;">
      <%= f.label :title, "Title *", style: lbl %>
      <%= f.text_field :title, placeholder: "e.g. What great school leadership actually looks like", style: inp %>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:1.25rem;">
      <div>
        <%= f.label :author, "Author", style: lbl %>
        <%= f.text_field :author, placeholder: "e.g. The Schools of India", style: inp %>
      </div>
      <div>
        <%= f.label :category, "Category", style: lbl %>
        <%= f.select :category,
              options_for_select(category_options, post.category),
              { include_blank: "— none —" },
              style: inp %>
      </div>
    </div>

    <div style="margin-bottom:1.25rem;">
      <%= f.label :cover_image, "Cover image URL", style: lbl %>
      <%= f.text_field :cover_image, placeholder: "/images/blog/my-post.jpg or https://…", style: inp %>
      <p style="<%= hint %>">Paste a full URL, or upload it under <strong>Images</strong> below and click “Use as cover”.</p>
    </div>

    <div style="margin-bottom:1.25rem;">
      <%= f.label :cover_image_alt, "Cover image alt text", style: lbl %>
      <%= f.text_field :cover_image_alt, placeholder: "Describe the banner image for screen readers and Google Images", style: inp %>
    </div>

    <div style="margin-bottom:1.25rem;">
      <%= f.label :excerpt, "Excerpt", style: lbl %>
      <%= f.text_area :excerpt, rows: 2, placeholder: "One or two lines shown on the blog listing. Leave blank to use the opening paragraph.", style: inp %>
    </div>

    <div>
      <%= f.label :body, "Body *", style: lbl %>
      <%= f.text_area :body, rows: 24, placeholder: "Write or paste the article in Markdown.\n\n## A section heading\n\nA paragraph with **bold** and a [link](https://example.com).\n\n![Alt text](/images/blog/my-infographic.png)", style: inp + " line-height:1.7; font-family:ui-monospace,Menlo,monospace; font-size:13px;" %>
      <div style="display:flex; align-items:center; gap:12px; margin-top:8px;">
        <button type="button" id="body-preview-btn" data-preview-url="<%= admin_preview_posts_path %>"
                style="background:none; border:1px solid rgba(0,0,0,0.2); border-radius:4px; padding:7px 14px; font-size:12px; font-weight:600; cursor:pointer;">Preview</button>
        <p style="<%= hint %> margin:0;">Markdown — headings with <code>##</code>, links with <code>[text](url)</code>, images with <code>![alt](url)</code>. Separate paragraphs with a blank line.</p>
      </div>
      <div id="body-preview" style="display:none; margin-top:1.25rem; border:1px solid rgba(0,0,0,0.12); border-radius:4px; background:#f4f0e6;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 14px; border-bottom:1px solid rgba(0,0,0,0.1);">
          <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; opacity:0.55;">Preview — how the article body will render</span>
          <button type="button" id="body-preview-close" style="background:none; border:none; font-size:16px; line-height:1; cursor:pointer; opacity:0.5;">&times;</button>
        </div>
        <p id="body-preview-meta" style="margin:0; padding:10px 14px 0; font-size:11px; opacity:0.5;"></p>
        <div id="body-preview-html" class="article-body" style="padding:1.5rem;"></div>
      </div>
    </div>
  </div>

  <%# Images: uploaded straight away with JS so the form isn't submitted; the file input has no name. %>
  <div id="blog-images" data-upload-url="<%= admin_post_images_path %>" style="background:white; border:1px solid rgba(0,0,0,0.08); padding:1.75rem; margin-bottom:1.5rem;">
    <p style="<%= lbl %>">Images (banner &amp; infographics)</p>
    <input type="file" id="blog-images-input" multiple accept="image/png,image/jpeg,image/webp,image/gif" style="font-size:13px;">
    <p style="<%= hint %>">Uploads to <code>/images/blog/</code>. For each image, set the alt text, then copy its Markdown into the Body where it should appear. JPG, PNG, WebP or GIF, up to 10 MB.</p>
    <p id="blog-images-status" style="font-size:12px; margin:10px 0 0; display:none;"></p>
    <div id="blog-images-list"></div>
  </div>

  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:1.75rem; margin-bottom:1.5rem;">
    <p style="<%= lbl %> opacity:0.8; margin-bottom:1.25rem;">SEO / structured data</p>

    <div style="margin-bottom:1.25rem;">
      <%= f.label :meta_title, "Meta title", style: lbl %>
      <%= f.text_field :meta_title, placeholder: "Shown as the Google result title. Leave blank to use the post title.", style: inp, data: { count: "50-60" } %>
      <p style="<%= hint %>">Aim for 50–60 characters. <span data-count-for="post_meta_title"></span></p>
    </div>

    <div style="margin-bottom:1.25rem;">
      <%= f.label :meta_description, "Meta description", style: lbl %>
      <%= f.text_area :meta_description, rows: 3, placeholder: "The snippet under the Google result. Leave blank to use the excerpt.", style: inp, data: { count: "150-160" } %>
      <p style="<%= hint %>">Aim for 150–160 characters. <span data-count-for="post_meta_description"></span></p>
    </div>

    <div>
      <%= f.label :json_ld, "JSON-LD", style: lbl %>
      <%= f.text_area :json_ld, rows: 12, placeholder: "Paste the structured-data block from the pipeline (Article + FAQPage). With or without the <script type=\"application/ld+json\"> tags.", style: inp + " font-family:ui-monospace,Menlo,monospace; font-size:12px;" %>
      <p style="<%= hint %>">Added to the page &lt;head&gt; exactly as pasted. Must be valid JSON — the post won't save otherwise.</p>
    </div>
  </div>

  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:1.75rem; margin-bottom:1.5rem;">
    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
      <%= f.check_box :published, style: "width:16px; height:16px; accent-color:#821E25;" %>
      <span style="font-size:13px; font-weight:600;">Published — visible on /blog</span>
    </label>
    <p style="font-size:11px; opacity:0.45; margin:8px 0 0 26px;">Leave unticked to keep it as a draft. The publish date is stamped automatically the first time you publish.</p>

    <div style="margin-top:1.25rem;">
      <%= f.label :publish_at, "Publish at", style: lbl %>
      <%= f.datetime_local_field :publish_at, value: post.publish_at&.strftime("%Y-%m-%dT%H:%M"), style: inp %>
      <p style="<%= hint %>">Optional. Leave blank to publish immediately when “Published” is ticked. Set a future date and tick “Published” to schedule — the post stays hidden from /blog until then.</p>
    </div>

    <div style="margin-top:1.25rem;">
      <%= f.label :slug, "URL slug", style: lbl %>
      <%= f.text_field :slug, placeholder: "auto-generated from the title", style: inp,
            data: { live: post.published? && post.persisted?, original: post.slug_was } %>
      <p style="<%= hint %>">Leave blank to generate from the title. Changing this on a live post breaks existing links.</p>
      <p id="slug-warning" style="display:none; font-size:12px; font-weight:600; color:#991b1b; margin:6px 0 0;">This post is live — changing the slug breaks every existing link to it, including Google results.</p>
    </div>
  </div>

  <div style="display:flex; align-items:center; gap:1rem;">
    <%= f.submit submit_label, style:"background:#821E25; color:white; padding:11px 28px; font-size:13px; font-weight:700; border:none; border-radius:4px; cursor:pointer;" %>
    <%= link_to "Cancel", admin_posts_path, style:"color:#999; font-size:13px; font-weight:600; text-decoration:none;" %>
  </div>
<% end %>

<style>
  /* Mirror the public article-body styles so the preview matches /blog. */
  #body-preview .article-body h2 { font-family:'Playfair Display',Georgia,serif; font-size:1.6rem; line-height:1.25; font-weight:700; margin:2rem 0 1rem; }
  #body-preview .article-body h3 { font-size:1.2rem; font-weight:700; margin:1.6rem 0 0.8rem; }
  #body-preview .article-body p { font-size:1.05rem; line-height:1.8; color:rgba(0,0,0,0.75); margin:0 0 1.2rem; }
  #body-preview .article-body a { color:#821E25; text-decoration:underline; text-underline-offset:3px; }
  #body-preview .article-body strong { font-weight:600; }
  #body-preview .article-body ul, #body-preview .article-body ol { font-size:1.05rem; line-height:1.8; color:rgba(0,0,0,0.75); margin:0 0 1.2rem; padding-left:1.5rem; }
  #body-preview .article-body ul { list-style:disc; }
  #body-preview .article-body ol { list-style:decimal; }
  #body-preview .article-body li { margin-bottom:0.3rem; }
  #body-preview .article-body img { display:block; max-width:100%; height:auto; margin:1.5rem auto; border-radius:4px; }
  #body-preview .article-body .table-wrap { overflow-x:auto; margin:0 0 1.5rem; }
  #body-preview .article-body table { width:100%; border-collapse:collapse; font-size:0.95rem; background:white; border:1px solid rgba(130,30,37,0.25); }
  #body-preview .article-body th, #body-preview .article-body td { text-align:left; padding:0.7rem 0.9rem; border-bottom:1px solid rgba(0,0,0,0.08); vertical-align:top; }
  #body-preview .article-body th { background:#821E25; color:white; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; }
  #body-preview .article-body blockquote { border-left:3px solid #821E25; margin:0 0 1.2rem; padding:0.2rem 0 0.2rem 1.2rem; font-style:italic; }
</style>

<script>
  (function () {
    // Markdown preview: render the Body through the same pipeline as /blog.
    var previewBtn = document.getElementById("body-preview-btn");
    var previewPanel = document.getElementById("body-preview");
    var previewHtml = document.getElementById("body-preview-html");
    var previewMeta = document.getElementById("body-preview-meta");
    var body = document.getElementById("post_body");
    var csrf = document.querySelector('meta[name="csrf-token"]');
    if (previewBtn && body) {
      previewBtn.addEventListener("click", function () {
        previewBtn.disabled = true;
        previewBtn.textContent = "Rendering…";
        fetch(previewBtn.dataset.previewUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json", "X-CSRF-Token": csrf ? csrf.content : "" },
          credentials: "same-origin",
          body: JSON.stringify({
            body: body.value,
            title: (document.getElementById("post_title") || {}).value,
            excerpt: (document.getElementById("post_excerpt") || {}).value,
            meta_title: (document.getElementById("post_meta_title") || {}).value,
            meta_description: (document.getElementById("post_meta_description") || {}).value
          })
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            previewHtml.innerHTML = data.html || "<p style='opacity:0.5'>Nothing to preview yet.</p>";
            previewMeta.textContent = "Title: " + (data.title || "") + "  ·  Description: " + (data.description || "");
            previewPanel.style.display = "block";
            previewPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
          })
          .catch(function () { previewHtml.innerHTML = "<p style='color:#991b1b'>Preview failed. Try again.</p>"; previewPanel.style.display = "block"; })
          .finally(function () { previewBtn.disabled = false; previewBtn.textContent = "Preview"; });
      });
      document.getElementById("body-preview-close").addEventListener("click", function () { previewPanel.style.display = "none"; });
    }

    // Character counters for the meta fields.
    document.querySelectorAll("[data-count]").forEach(function (field) {
      var out = document.querySelector('[data-count-for="' + field.id + '"]');
      var range = field.dataset.count.split("-").map(Number);
      var update = function () {
        var n = field.value.length;
        out.textContent = n + " now";
        out.style.color = n === 0 ? "" : (n >= range[0] && n <= range[1] ? "#166534" : "#b45309");
        out.style.fontWeight = "600";
      };
      field.addEventListener("input", update);
      update();
    });

    // Warn before changing the slug of a live post.
    var slug = document.getElementById("post_slug");
    var slugWarning = document.getElementById("slug-warning");
    if (slug && slug.dataset.live === "true") {
      slug.addEventListener("input", function () {
        slugWarning.style.display = slug.value !== slug.dataset.original ? "block" : "none";
      });
    }

    // Image uploads -> Markdown snippets.
    var box = document.getElementById("blog-images");
    var input = document.getElementById("blog-images-input");
    var list = document.getElementById("blog-images-list");
    var status = document.getElementById("blog-images-status");
    if (!box || !input) return;

    var esc = function (s) { return s.replace(/[\[\]]/g, ""); };
    var btn = "background:none; border:1px solid rgba(0,0,0,0.2); border-radius:4px; padding:6px 12px; font-size:12px; font-weight:600; cursor:pointer;";

    function addRow(img) {
      var row = document.createElement("div");
      row.style.cssText = "display:grid; grid-template-columns:72px 1fr; gap:14px; align-items:start; padding:14px 0; border-top:1px solid rgba(0,0,0,0.06); margin-top:14px;";
      if (img.error) {
        row.innerHTML = '<div></div><p style="margin:0; font-size:12px; color:#991b1b;"></p>';
        row.querySelector("p").textContent = img.name + ": " + img.error;
        list.appendChild(row);
        return;
      }
      row.innerHTML =
        '<img style="width:72px; height:52px; object-fit:cover; border-radius:3px; background:#eee;">' +
        '<div>' +
        '  <input type="text" placeholder="Alt text" style="width:100%; padding:7px 10px; border:1px solid rgba(0,0,0,0.15); border-radius:4px; font-size:13px; box-sizing:border-box; margin-bottom:8px;">' +
        '  <code style="display:block; font-size:12px; background:#f6f6f6; padding:7px 10px; border-radius:4px; word-break:break-all; margin-bottom:8px;"></code>' +
        '  <button type="button" data-act="copy" style="' + btn + '">Copy Markdown</button> ' +
        '  <button type="button" data-act="cover" style="' + btn + '">Use as cover</button>' +
        '</div>';
      var alt = row.querySelector("input");
      var code = row.querySelector("code");
      row.querySelector("img").src = img.url;
      alt.value = img.alt || "";
      var snippet = function () { return "![" + esc(alt.value) + "](" + img.url + ")"; };
      var render = function () { code.textContent = snippet(); };
      alt.addEventListener("input", render);
      render();

      row.querySelector('[data-act="copy"]').addEventListener("click", function (e) {
        var b = e.currentTarget;
        if (!navigator.clipboard) {
          // No clipboard API (plain http): select the snippet so it can be copied by hand.
          window.getSelection().selectAllChildren(code);
          return;
        }
        navigator.clipboard.writeText(snippet()).then(function () {
          b.textContent = "Copied ✓";
          setTimeout(function () { b.textContent = "Copy Markdown"; }, 1500);
        });
      });
      row.querySelector('[data-act="cover"]').addEventListener("click", function (e) {
        document.getElementById("post_cover_image").value = img.url;
        document.getElementById("post_cover_image_alt").value = alt.value;
        e.currentTarget.textContent = "Set as cover ✓";
      });
      list.appendChild(row);
    }

    input.addEventListener("change", function () {
      if (!input.files.length) return;
      var data = new FormData();
      Array.prototype.forEach.call(input.files, function (f) { data.append("images[]", f); });
      status.style.display = "block";
      status.style.color = "";
      status.textContent = "Uploading " + input.files.length + " image(s)…";

      fetch(box.dataset.uploadUrl, {
        method: "POST",
        body: data,
        headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content, "Accept": "application/json" },
        credentials: "same-origin"
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.json.error || "Upload failed.");
          res.json.images.forEach(addRow);
          status.textContent = "Done. Copy each snippet into the Body where the image should appear.";
          input.value = "";
        })
        .catch(function (err) {
          status.style.color = "#991b1b";
          status.textContent = err.message;
        });
    });
  })();
</script>
