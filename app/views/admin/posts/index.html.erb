<% content_for :title, "Blog Posts" %>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
  <h1 style="font-size:1.5rem; font-weight:700; margin:0;">Blog Posts</h1>
  <%= link_to "+ New Post", new_admin_post_path, style:"background:#821E25; color:white; padding:8px 18px; font-size:13px; font-weight:700; text-decoration:none; border-radius:4px;" %>
</div>

<% if @posts.any? %>
  <div style="background:white; border:1px solid rgba(0,0,0,0.08);">
    <table style="width:100%; border-collapse:collapse; font-size:13px;">
      <thead>
        <tr style="border-bottom:2px solid rgba(0,0,0,0.08);">
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Cover</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Title</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Category</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Date</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Status</th>
          <th style="padding:10px 16px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr style="border-bottom:1px solid rgba(0,0,0,0.05);">
            <td style="padding:12px 16px;">
              <% if post.cover_image.present? %>
                <img src="<%= post.cover_image %>" style="width:56px; height:38px; object-fit:cover; border-radius:3px;" onerror="this.style.display='none'">
              <% else %>
                <div style="width:56px; height:38px; background:rgba(0,0,0,0.06); border-radius:3px;"></div>
              <% end %>
            </td>
            <td style="padding:12px 16px; font-weight:600; max-width:340px;">
              <%= post.title %>
              <div style="font-size:11px; opacity:0.4; font-weight:400;">/blog/<%= post.slug %></div>
            </td>
            <td style="padding:12px 16px; opacity:0.65;"><%= post.category.presence || "—" %></td>
            <td style="padding:12px 16px; opacity:0.65; white-space:nowrap;"><%= post.display_date %></td>
            <td style="padding:12px 16px;">
              <% if post.published? %>
                <span style="background:#f0fdf4; color:#166534; padding:3px 9px; border-radius:100px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em;">Live</span>
              <% else %>
                <span style="background:rgba(0,0,0,0.05); color:#777; padding:3px 9px; border-radius:100px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em;">Draft</span>
              <% end %>
            </td>
            <td style="padding:12px 16px; text-align:right; white-space:nowrap;">
              <% if post.published? %>
                <%= link_to "View", blog_post_path(post), target: "_blank", style:"color:#999; font-size:12px; font-weight:600; text-decoration:none; margin-right:12px;" %>
              <% end %>
              <%= link_to "Edit", edit_admin_post_path(post), style:"color:#821E25; font-size:12px; font-weight:600; text-decoration:none; margin-right:12px;" %>
              <%= button_to "Delete", admin_post_path(post), method: :delete,
                    form: { style: "display:inline;" },
                    data: { turbo_confirm: "Delete “#{post.title}”?" },
                    style:"background:none; border:none; color:#999; font-size:12px; font-weight:600; cursor:pointer; padding:0;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:3rem; text-align:center; color:#999;">
    <p style="margin:0 0 1rem; font-size:1rem;">No blog posts yet.</p>
    <%= link_to "Write your first post →", new_admin_post_path, style:"color:#821E25; font-weight:700; text-decoration:none;" %>
  </div>
<% end %>

<div style="margin-top:2rem; padding-top:1rem; border-top:1px solid rgba(0,0,0,0.08); font-size:12px; opacity:0.5;">
  Published posts appear at <%= link_to "/blog", blog_path, target: "_blank", style:"color:#821E25;" %>. Drafts stay hidden until you tick “Published”.
</div>
