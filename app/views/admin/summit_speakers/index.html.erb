<% content_for :title, "Summit Speakers" %>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem;">
  <h1 style="font-size:1.5rem; font-weight:700; margin:0;">Summit Speakers</h1>
  <%= link_to "+ Add Speaker", new_admin_summit_speaker_path, style:"background:#821E25; color:white; padding:8px 18px; font-size:13px; font-weight:700; text-decoration:none; border-radius:4px;" %>
</div>

<% if notice %>
  <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:10px 16px; margin-bottom:1.5rem; border-radius:4px; font-size:13px;">
    <%= notice %>
  </div>
<% end %>

<% if @speakers.any? %>
  <div style="background:white; border:1px solid rgba(0,0,0,0.08);">
    <table style="width:100%; border-collapse:collapse; font-size:13px;">
      <thead>
        <tr style="border-bottom:2px solid rgba(0,0,0,0.08);">
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5; width:50px;">Order</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Photo</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Name</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Title</th>
          <th style="text-align:left; padding:10px 16px; font-size:10px; text-transform:uppercase; letter-spacing:0.12em; opacity:0.5;">Organisation</th>
          <th style="padding:10px 16px;"></th>
        </tr>
      </thead>
      <tbody>
        <% @speakers.each do |speaker| %>
          <tr style="border-bottom:1px solid rgba(0,0,0,0.05);">
            <td style="padding:12px 16px; opacity:0.5; font-size:12px;"><%= speaker.position %></td>
            <td style="padding:12px 16px;">
              <% if speaker.photo.present? %>
                <% thumb_url = speaker.photo.split('?').first + "?v=#{speaker.updated_at.to_i}" %>
                <img src="<%= thumb_url %>" style="width:44px; height:44px; object-fit:cover; border-radius:50%; border:2px solid <%= speaker.accent_color %>;" onerror="this.style.display='none'">
              <% else %>
                <div style="width:44px; height:44px; border-radius:50%; background:<%= speaker.accent_color %>; opacity:0.3;"></div>
              <% end %>
            </td>
            <td style="padding:12px 16px; font-weight:600;"><%= speaker.name %></td>
            <td style="padding:12px 16px; opacity:0.65;"><%= speaker.title %></td>
            <td style="padding:12px 16px; opacity:0.65;"><%= speaker.organisation %></td>
            <td style="padding:12px 16px; text-align:right; white-space:nowrap;">
              <%= link_to "Edit", edit_admin_summit_speaker_path(speaker), style:"color:#821E25; font-size:12px; font-weight:600; text-decoration:none; margin-right:12px;" %>
              <%= button_to "Remove", admin_summit_speaker_path(speaker), method: :delete,
                    data: { turbo_confirm: "Remove #{speaker.name}?" },
                    style:"background:none; border:none; color:#999; font-size:12px; font-weight:600; cursor:pointer; padding:0;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div style="background:white; border:1px solid rgba(0,0,0,0.08); padding:3rem; text-align:center; color:#999;">
    <p style="margin:0 0 1rem; font-size:1rem;">No speakers added yet.</p>
    <%= link_to "Add your first speaker →", new_admin_summit_speaker_path, style:"color:#821E25; font-weight:700; text-decoration:none;" %>
  </div>
<% end %>

<div style="margin-top:2rem; padding-top:1rem; border-top:1px solid rgba(0,0,0,0.08);">
  <p style="font-size:12px; opacity:0.5; margin:0;">
    Speaker photos can be a URL (https://...) or a local path (e.g. <code>/summit/assets/advisor_lakshmi.jpg</code>).
    Use the Order field to control display sequence on the summit page.
  </p>
</div>
