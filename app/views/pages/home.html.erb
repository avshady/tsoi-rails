<style>
body { background-color: #f4f0e6 !important; }
@media (max-width: 900px) {
  .pillars-scroll-wrap { height:300vh; position:relative; }
  .pillars-section { height:100vh !important; position:sticky !important; top:0; }
  .pillars-grid {
    grid-template-columns: none !important;
    display: flex !important;
    width: 300% !important;
    will-change: transform;
  }
  .pillars-grid > a {
    flex: 0 0 33.3333% !important;
    width: 33.3333% !important;
    height: 100% !important;
  }
  .pillars-grid > a > div { border-right: none !important; }
  .pillars-dots { display: flex !important; }
  .stats-grid { grid-template-columns: 1fr 1fr !important; }
}
@media (max-width: 640px) {
