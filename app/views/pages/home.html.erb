<% content_for :title, "The Schools of India | Launch, Build & Scale Your School" %>

<style>
/* Page-level theme overrides */
body { background-color: #f4f0e6 !important; }

@keyframes blob {
  0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; transform: translate(0,0) scale(1); }
  33%       { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; transform: translate(30px,-20px) scale(1.05); }
  66%       { border-radius: 50% 60% 30% 60% / 30% 60% 70% 40%; transform: translate(-20px,15px) scale(0.97); }
}
.blob { animation: blob 8s ease-in-out infinite; }
.blob-delay-2 { animation-delay: 2s; }
.blob-delay-4 { animation-delay: 4s; }

@keyframes marquee-lbs { from { transform:translateX(0); } to { transform:translateX(-50%); } }
.marquee-lbs { animation: marquee-lbs 22s linear infinite; }

.pillar:hover .pillar-shape { transform: scale(1.06); }
.pillar-shape { transition: transform 0.7s cubic-bezier(0.16,1,0.3,1); }
.pillar:hover .pillar-arrow { background:#821E25; color:white; border-color:#821E25; }
.pillar-arrow { transition: background 0.2s, color 0.2s, border-color 0.2s; }

@keyframes spin-slow { to { transform: rotate(360deg); } }
.spin-slow { animation: spin-slow 20s linear infinite; }

@keyframes fadeUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
.fade-up { animation: fadeUp 0.8s ease forwards; }
</style>

<!-- ════════════════════════════════
     HERO
════════════════════════════════ -->
<section style="background:#f4f0e6; min-height:calc(100vh - 73px); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; padding:4rem 3rem;">
  <!-- Blobs -->
  <div class="blob" style="position:absolute; top:10%; left:8%; width:320px; height:320px; background:#821E25; mix-blend-mode:multiply; opacity:0.18; filter:blur(60px); pointer-events:none;"></div>
  <div class="blob blob-delay-2" style="position:absolute; top:30%; right:10%; width:280px; height:280px; background:#e4f0fc; mix-blend-mode:multiply; opacity:0.7; filter:blur(60px); pointer-events:none;"></div>
  <div class="blob blob-delay-4" style="position:absolute; bottom:-5%; left:28%; width:360px; height:360px; background:#fad0c0; mix-blend-mode:multiply; opacity:0.6; filter:blur(60px); pointer-events:none;"></div>

  <div style="max-width:1280px; width:100%; margin:0 auto; position:relative; z-index:1;">
    <div style="text-align:center; display:flex; flex-direction:column; align-items:center;">
      <!-- Pill badge -->
      <div style="display:inline-flex; align-items:center; gap:8px; border:2px solid #101010; background:white; padding:8px 20px; border-radius:100px; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; margin-bottom:2.5rem; box-shadow:4px 4px 0 #101010; transform:rotate(-1.5deg);">
        Empowering Education Since Day One
      </div>

      <!-- Headline -->
      <h1 style="font-family:Georgia,serif; font-size:clamp(2.5rem,5vw,5rem); font-weight:700; line-height:1.08; letter-spacing:-0.03em; color:#1A1A1A; margin:0 0 1.5rem; max-width:820px;">
        Everything you need<br>to build
        <em style="font-style:normal; color:#821E25;"> Great Schools.</em>
      </h1>

      <!-- Sub -->
      <p style="font-size:clamp(1rem,1.5vw,1.25rem); font-weight:400; color:rgba(0,0,0,0.55); max-width:680px; line-height:1.65; margin:0 0 3rem;">
        Whether you're starting your first school from scratch, optimising current operations, or scaling across states, we provide the network and systems.
      </p>

      <!-- CTAs -->
      <div style="display:flex; flex-wrap:wrap; gap:1.25rem; justify-content:center;">
        <%= link_to partner_path, style: "display:inline-flex; align-items:center; gap:8px; background:#1A1A1A; color:#f4f0e6; font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:0.15em; padding:16px 32px; border-radius:100px; text-decoration:none; transition:transform 0.2s, background 0.2s; box-shadow:4px 4px 0 rgba(0,0,0,0.15);", onmouseover: "this.style.transform='translateY(-2px)'", onmouseout: "this.style.transform='translateY(0)'" do %>
          Explore Our Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        <% end %>
        <%= link_to parents_path, style: "display:inline-flex; align-items:center; gap:8px; background:transparent; color:#1A1A1A; font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:0.15em; padding:16px 32px; border-radius:100px; text-decoration:none; border:2px solid rgba(0,0,0,0.2); transition:border-color 0.2s;", onmouseover: "this.style.borderColor='#1A1A1A'", onmouseout: "this.style.borderColor='rgba(0,0,0,0.2)'" do %>
          Find Schools →
        <% end %>
      </div>
    </div>

    <!-- Floating school images -->
    <div style="position:absolute; bottom:-2rem; left:3rem; width:160px; height:160px; border-radius:50%; border:4px solid white; box-shadow:0 8px 32px rgba(0,0,0,0.15); overflow:hidden; transform:rotate(-6deg); display:none;" class="lg-show">
