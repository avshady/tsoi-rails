<!-- Scrolling ticker -->
<div style="width:100%; overflow:hidden; background:#101010; padding:14px 0; border-top:2px solid rgba(255,255,255,0.06);">
  <div class="marquee-lbs" style="display:flex; gap:0; white-space:nowrap; width:max-content;">
    <% 2.times do %>
      <% ["Launch a School", "Board Affiliation", "CBSE · ICSE · IB · IGCSE", "Land & Infrastructure", "Regulatory Approvals", "Curriculum Systems", "Staff Recruitment", "ERP & Tech Stack", "Fee Management", "TSOI Certification", "Multi Campus Expansion", "School Franchise", "Future Schools Summit", "₹60K+ Schools on Platform"].each do |word| %>
        <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; color:rgba(255,255,255,0.35); padding:0 2rem; flex-shrink:0;">
          <%= word %> <span style="color:#821E25;">·</span>
        </span>
      <% end %>
    <% end %>
  </div>
</div>

