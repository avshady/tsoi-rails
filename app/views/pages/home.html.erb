}
</style>

<script>
(function() {
  var wrap = document.querySelector('.pillars-scroll-wrap');
  var grid = document.querySelector('.pillars-grid');
  var dots = document.querySelectorAll('.pillar-dot');
  if (!wrap || !grid) return;

  var ticking = false;

  function update() {
    ticking = false;
    if (window.innerWidth > 900) { grid.style.transform = ''; return; }
    var rect = wrap.getBoundingClientRect();
    var scrollable = wrap.offsetHeight - window.innerHeight;
    if (scrollable <= 0) return;
    var progress = -rect.top / scrollable;
    progress = Math.max(0, Math.min(1, progress));
    grid.style.transform = 'translateX(-' + (progress * 66.6667) + '%)';
    if (dots.length) {
      var idx = Math.round(progress * (dots.length - 1));
      dots.forEach(function(d, i) {
        d.style.background = i === idx ? '#821E25' : 'rgba(0,0,0,0.2)';
        d.style.width = i === idx ? '18px' : '6px';
      });
    }
  }

  function onScroll() {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

