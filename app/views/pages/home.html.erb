    </div>
    <div style="position:absolute; top:2rem; right:3rem; width:140px; height:140px; border-radius:24px; border:4px solid white; box-shadow:0 8px 32px rgba(0,0,0,0.15); overflow:hidden; transform:rotate(8deg); display:none;" class="lg-show">
