.summit-popup-badge {
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 100px; padding: 4px 12px;
  font-size: 0.75rem; font-weight: 500; color: rgba(255,255,255,0.7);
}
.summit-popup-desc {
  font-size: 0.82rem; color: rgba(255,255,255,0.55);
  line-height: 1.6; margin-bottom: 1.25rem;
}
.summit-popup-actions {
  display: flex; gap: 0.75rem; flex-wrap: wrap;
}
.summit-popup-cta {
  display: inline-flex; align-items: center; gap: 6px;
  background: #ff2a7f; color: #fff;
  padding: 0.7rem 1.5rem; border-radius: 100px;
  font-weight: 700; font-size: 0.875rem; text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 20px rgba(255,42,127,0.4);
}
.summit-popup-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(255,42,127,0.5); }
.summit-popup-dismiss {
  display: inline-flex; align-items: center;
  background: transparent; border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.5); padding: 0.7rem 1.25rem;
  border-radius: 100px; font-size: 0.875rem; cursor: pointer;
  font-family: inherit; transition: border-color 0.2s, color 0.2s;
}
.summit-popup-dismiss:hover { border-color: rgba(255,255,255,0.35); color: #fff; }
@media (max-width: 480px) {
  #summit-popup { padding: 2rem 1.5rem 1.5rem; }
  .summit-popup-cta, .summit-popup-dismiss { width: 100%; justify-content: center; }
}
</style>

<div id="summit-popup-backdrop" role="dialog" aria-modal="true" aria-label="Summit Announcement">
  <div id="summit-popup">
    <div class="summit-popup-glow" style="width:200px;height:200px;background:#ff2a7f;opacity:0.12;top:-60px;right:-40px;"></div>
    <div class="summit-popup-glow" style="width:150px;height:150px;background:#7c3aed;opacity:0.1;bottom:-40px;left:-30px;"></div>

    <button class="summit-popup-close" id="summit-popup-close" aria-label="Close">✕</button>

    <div class="summit-popup-tag">Now Announced</div>

    <h2 class="summit-popup-title">
      The Schools of India<br><em>Education Summit 2026</em>
    </h2>

    <div class="summit-popup-meta">
      <span class="summit-popup-badge">📅 30 Oct – 1 Nov 2026</span>
      <span class="summit-popup-badge">📍 Novotel Imagicaa, Khopoli</span>
    </div>

    <p class="summit-popup-desc">
      India's premier gathering for school founders, principals, and education leaders. Three days of bold ideas, keynotes, and workshops to shape the future of K-12 education.
    </p>

    <div class="summit-popup-actions">
      <a href="/summit" class="summit-popup-cta">
        Explore the Summit →
      </a>
      <button class="summit-popup-dismiss" id="summit-popup-dismiss">Maybe later</button>
    </div>
  </div>
</div>

<script>
(function() {
  var backdrop = document.getElementById('summit-popup-backdrop');
  var closeBtn = document.getElementById('summit-popup-close');
  var dismissBtn = document.getElementById('summit-popup-dismiss');

  function closePopup() {
    backdrop.classList.remove('is-visible');
  }

  closeBtn.addEventListener('click', closePopup);
  dismissBtn.addEventListener('click', closePopup);
  backdrop.addEventListener('click', function(e) {
    if (e.target === backdrop) closePopup();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closePopup();
  });

  setTimeout(function() {
    backdrop.classList.add('is-visible');
  }, 1500);
})();
</script>
