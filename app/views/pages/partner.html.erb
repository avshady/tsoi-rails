<% content_for :title, "Partner With Us — The Schools of India" %>

<style>
body { background:#f4f0e6 !important; }
.partner-cards-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; align-items:stretch; }
.partner-card {
  display:flex; flex-direction:column; height:100%;
  transition: box-shadow 0.25s, border-color 0.25s;
}
.partner-card:hover { box-shadow: 0 6px 32px rgba(130,30,37,0.1); border-color: #821E25 !important; }
.partner-card:hover img { transform: scale(1.04); }
.partner-card img { transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }
.partner-card-body { display:flex; flex-direction:column; flex:1; padding:28px 28px 32px; }
.partner-card-cta { margin-top:auto; }

@media (max-width:900px) {
  .partner-hero-grid { grid-template-columns:1fr !important; gap:2rem !important; align-items:start !important; }
  .partner-cards-grid { grid-template-columns:1fr !important; }
  .how-it-works-grid { grid-template-columns:1fr 1fr !important; gap:2rem !important; }
}
@media (max-width:640px) {
  section { padding-left:1.25rem !important; padding-right:1.25rem !important; }
  .how-it-works-grid { grid-template-columns:1fr !important; }
  .dark-cta-flex { flex-direction:column !important; align-items:flex-start !important; gap:2rem !important; }
}
</style>

<!-- HERO -->
<section style="background:#f4f0e6; padding:6rem 3rem 4rem; max-width:1280px; margin:0 auto;">
  <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1.5rem;">Join the Network</p>
  <div class="partner-hero-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:end;">
    <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(2.8rem,5vw,5rem); line-height:1.08; color:#1A1A1A; margin:0; font-weight:700; letter-spacing:-0.03em;">
      Partner With<br><em style="color:#821E25;">The Schools<br>of India.</em>
    </h1>
    <div>
      <p style="font-size:1.05rem; color:rgba(0,0,0,0.6); line-height:1.8; font-weight:300; margin:0 0 2rem;">
        Whether you're a school, a vendor, or a landowner — TSOI offers meaningful partnerships that open real doors across India's education landscape.
      </p>
      <%= link_to contact_path, style: "display:inline-flex; align-items:center; gap:10px; background:#821E25; color:white; text-decoration:none; padding:16px 32px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border-radius:100px;", onmouseover: "this.style.background='#5F1219'", onmouseout: "this.style.background='#821E25'" do %>
        Get in Touch
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      <% end %>
    </div>
  </div>
</section>


<!-- PARTNER TYPES -->
<section style="background:#f4f0e6; padding:0 3rem 5rem; max-width:1280px; margin:0 auto;">
  <div class="partner-cards-grid">
    <% [
      {
        role: "For Schools",
        label: "School Network",
        img: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&q=80&w=800",
        detail: "Join India's most trusted school directory. Access exclusive services — from ERP deployment to executive hiring — and grow your institution with TSOI's full ecosystem behind you.",
        bullets: ["Featured listing in the TSOI directory","Verified badge and school profile","Access to ERP, hiring and curriculum services","Co-branding and summit opportunities"]
      },
      {
        role: "For Vendors",
        label: "Vendor Network",
        img: "https://images.unsplash.com/photo-1573164574572-cb89e39749b4?auto=format&fit=crop&q=80&w=800",
        detail: "Connect your products and services with thousands of partnered schools through our verified vendor network. Get in front of the decision-makers who matter.",
        bullets: ["Direct access to 60,000+ school network","Verified vendor listing on platform","Curated introductions to school leaders","Summit expo and branding opportunities"]
      },
      {
        role: "For Landowners",
        label: "Real Estate",
        img: "https://images.unsplash.com/photo-1486325212027-8081e485255e?auto=format&fit=crop&q=80&w=800",
        detail: "Turn your real estate into a centre of learning. We facilitate build-to-lease agreements with top educational brands and guide you through every step.",
        bullets: ["Build-to-lease with top school brands","Land feasibility and zoning guidance","End-to-end school setup facilitation","Long-term revenue from education infrastructure"]
      }
    ].each do |p| %>
      <div class="partner-card" style="border:1px solid rgba(0,0,0,0.08); background:white; overflow:hidden;">
        <div style="aspect-ratio:16/9; overflow:hidden; background:#e8e4e0;">
          <img src="<%= p[:img] %>" alt="<%= p[:role] %>" style="width:100%; height:100%; object-fit:cover; filter:grayscale(0.3);">
        </div>
        <div class="partner-card-body">
          <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 6px;"><%= p[:label] %></p>
          <h3 style="font-family:'Playfair Display',Georgia,serif; font-size:1.4rem; font-weight:700; margin:0 0 0.85rem; color:#1A1A1A; letter-spacing:-0.01em;"><%= p[:role] %></h3>
          <p style="font-size:13px; color:rgba(0,0,0,0.6); margin:0 0 1.25rem; line-height:1.7;"><%= p[:detail] %></p>
          <ul style="list-style:none; margin:0 0 1.5rem; padding:0; border-top:1px solid rgba(0,0,0,0.06); padding-top:1rem; display:flex; flex-direction:column; gap:7px;">
            <% p[:bullets].each do |b| %>
              <li style="display:flex; align-items:flex-start; gap:9px; font-size:12px; color:rgba(0,0,0,0.65); line-height:1.5;">
                <span style="color:#821E25; flex-shrink:0; font-weight:700;">→</span><%= b %>
              </li>
            <% end %>
          </ul>
          <%= link_to "Start a conversation →", contact_path, class: "partner-card-cta", style: "font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; text-decoration:none; color:#821E25;" %>
        </div>
      </div>
    <% end %>
  </div>
</section>


<!-- HOW IT WORKS -->
<section style="background:#f4f0e6; padding:4rem 3rem 5rem; border-top:1px solid rgba(0,0,0,0.06);">
  <div style="max-width:1280px; margin:0 auto;">
    <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1rem;">The Process</p>
    <h2 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(2rem,3.5vw,3rem); font-weight:700; color:#1A1A1A; margin:0 0 3.5rem; letter-spacing:-0.02em; max-width:520px; line-height:1.1;">
      How it works.
    </h2>

    <div class="how-it-works-grid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:3rem;">
      <% [
        ["01","Apply","Fill in the partner enquiry form. It takes less than 3 minutes."],
        ["02","Review","Our team reviews your application within 48 hours."],
        ["03","Connect","We schedule a call to understand your specific goals."],
        ["04","Launch","You're fully onboarded into the TSOI partner ecosystem."]
      ].each do |num, title, desc| %>
        <div style="border-top:2px solid #821E25; padding-top:1.25rem;">
          <p style="font-family:'Playfair Display',Georgia,serif; font-size:2.5rem; font-weight:700; color:rgba(130,30,37,0.2); margin:0 0 1rem; line-height:1;"><%= num %></p>
          <h4 style="font-family:'Playfair Display',Georgia,serif; font-size:1.15rem; font-weight:700; color:#1A1A1A; margin:0 0 0.6rem;"><%= title %></h4>
          <p style="font-size:13px; color:rgba(0,0,0,0.55); margin:0; line-height:1.65;"><%= desc %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>


<!-- DARK CTA -->
<section style="background:#1A1A1A; padding:6rem 3rem;">
  <div class="dark-cta-flex" style="max-width:1280px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; gap:3rem; flex-wrap:wrap;">
    <div>
      <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1rem;">Ready to start?</p>
      <h2 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(1.75rem,3.5vw,3rem); font-weight:700; color:white; margin:0; letter-spacing:-0.02em; line-height:1.1;">
        Join India's most trusted<br><em style="color:#821E25;">school network.</em>
      </h2>
    </div>
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; flex-shrink:0;">
      <%= link_to contact_path, style: "display:inline-flex; align-items:center; gap:10px; background:#821E25; color:white; text-decoration:none; padding:16px 32px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border-radius:100px; transition:background 0.2s;", onmouseover: "this.style.background='#5F1219'", onmouseout: "this.style.background='#821E25'" do %>
        Contact Us
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      <% end %>
      <%= link_to "View Services →", services_path, style: "display:inline-flex; align-items:center; gap:8px; color:rgba(255,255,255,0.5); text-decoration:none; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border:1px solid rgba(255,255,255,0.12); padding:16px 28px; border-radius:100px; transition:all 0.2s;", onmouseover: "this.style.borderColor='rgba(255,255,255,0.4)';this.style.color='white'", onmouseout: "this.style.borderColor='rgba(255,255,255,0.12)';this.style.color='rgba(255,255,255,0.5)'" %>
    </div>
  </div>
</section>
