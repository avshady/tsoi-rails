<% content_for :title, "Partner With Us — The Schools of India" %>

<style>
.partner-card {
  border: 1px solid rgba(0,0,0,0.08);
  background: white;
  overflow: hidden;
  transition: box-shadow 0.25s, border-color 0.25s;
}
.partner-card:hover {
  box-shadow: 0 6px 32px rgba(130,30,37,0.1);
  border-color: #821E25;
}
.partner-card:hover .partner-card-img img {
  transform: scale(1.04);
}
.partner-card-img img { transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }

.step-num {
  font-family: Georgia, serif;
  font-size: 3.5rem;
  color: #821E25;
  opacity: 0.18;
  line-height: 1;
  margin: 0 0 1rem;
}
</style>

<!-- HERO -->
<div style="background:#f4f0e6; border-bottom:1px solid rgba(0,0,0,0.06); padding:5rem 3rem; text-align:center;">
  <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.3em; color:#821E25; margin:0 0 1.25rem;">Join the Network</p>
  <h1 style="font-family:Georgia,serif; font-size:clamp(2.25rem,5vw,4rem); color:#1A1A1A; margin:0 0 1.25rem; font-weight:400; letter-spacing:-0.02em; line-height:1.1;">
    Partner With<br><em style="color:#821E25;">The Schools of India</em>
  </h1>
  <p style="font-size:15px; color:#1A1A1A; opacity:0.55; font-weight:300; max-width:520px; margin:0 auto; line-height:1.75;">
    Whether you're a school, a vendor, or a landowner — TSOI offers meaningful partnerships that open real doors.
  </p>
</div>


<!-- PARTNER TYPES -->
<div style="max-width:1200px; margin:0 auto; padding:5rem 3rem;">

  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:1.5rem; margin-bottom:5rem;">
    <% [
      {
        role: "For Schools",
        label: "School Network",
        img: "https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&q=80&w=800",
        icon: "🏫",
        bullets: ["Featured in India's most trusted directory","Access to exclusive ERP & hiring services","Co-branding and event opportunities","Verified badge and school profile"]
      },
      {
        role: "For Vendors",
        label: "Vendor Network",
        img: "https://images.unsplash.com/photo-1573164574572-cb89e39749b4?auto=format&fit=crop&q=80&w=800",
        icon: "🤝",
        bullets: ["Direct access to 60,000+ school network","Verified vendor listing on platform","Curated introductions to school decision-makers","Summit expo and branding opportunities"]
      },
      {
        role: "For Landowners",
        label: "Real Estate",
        img: "https://images.unsplash.com/photo-1486325212027-8081e485255e?auto=format&fit=crop&q=80&w=800",
        icon: "🏗️",
        bullets: ["Build-to-lease agreements with top school brands","Land feasibility and zoning guidance","End-to-end school setup facilitation","Long-term revenue from education infrastructure"]
      }
    ].each do |p| %>
      <div class="partner-card">
        <div class="partner-card-img" style="aspect-ratio:16/9; overflow:hidden; background:#e8e4e0;">
          <img src="<%= p[:img] %>" alt="<%= p[:role] %>" style="width:100%; height:100%; object-fit:cover; filter:grayscale(0.2);">
        </div>
        <div style="padding:28px 28px 32px;">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:1rem;">
            <span style="font-size:1.4rem;"><%= p[:icon] %></span>
            <div>
              <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; color:#821E25; margin:0 0 2px;"><%= p[:label] %></p>
              <h3 style="font-family:Georgia,serif; font-size:1.35rem; font-weight:400; margin:0; color:#1A1A1A; letter-spacing:-0.01em;"><%= p[:role] %></h3>
            </div>
          </div>
          <ul style="list-style:none; margin:0 0 1.5rem; padding:0; display:flex; flex-direction:column; gap:8px;">
            <% p[:bullets].each do |b| %>
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:13px; color:#1A1A1A; opacity:0.7; line-height:1.5;">
                <span style="color:#821E25; flex-shrink:0; margin-top:1px;">→</span><%= b %>
              </li>
            <% end %>
          </ul>
          <%= link_to "Get in Touch →", contact_path, style: "font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; text-decoration:none; color:#821E25; border-bottom:1px solid rgba(130,30,37,0.3); padding-bottom:2px;" %>
        </div>
      </div>
    <% end %>
  </div>


  <!-- HOW IT WORKS -->
  <div style="border-top:1px solid rgba(0,0,0,0.06); padding-top:4rem; margin-bottom:4rem;">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.3em; color:#821E25; margin:0 0 0.75rem;">The Process</p>
      <h2 style="font-family:Georgia,serif; font-size:clamp(1.75rem,3.5vw,2.5rem); font-weight:400; margin:0; color:#1A1A1A; letter-spacing:-0.02em;">How it works</h2>
    </div>

    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0; border:1px solid rgba(0,0,0,0.07);">
      <% [
        ["01","Apply","Fill in the partner enquiry form. Takes less than 3 minutes."],
        ["02","Review","Our team reviews your application within 48 hours."],
        ["03","Connect","We schedule a call to understand your specific needs."],
        ["04","Launch","You're onboarded into the TSOI partner ecosystem."]
      ].each_with_index do |(num,title,desc),i| %>
        <div style="background:white; padding:2.25rem 1.75rem; <%= i<3 ? 'border-right:1px solid rgba(0,0,0,0.07);' : '' %>">
          <p class="step-num"><%= num %></p>
          <h4 style="font-family:Georgia,serif; font-size:1.1rem; font-weight:400; margin:0 0 8px; color:#1A1A1A;"><%= title %></h4>
          <p style="font-size:12px; color:#1A1A1A; opacity:0.5; margin:0; line-height:1.65;"><%= desc %></p>
        </div>
      <% end %>
    </div>
  </div>


  <!-- CTA BAND -->
  <div style="background:#1A1A1A; color:white; padding:4rem 3rem; display:flex; justify-content:space-between; align-items:center; gap:2rem; flex-wrap:wrap;">
    <div>
      <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.3em; color:rgba(255,255,255,0.4); margin:0 0 0.75rem;">Ready to start?</p>
      <h2 style="font-family:Georgia,serif; font-size:clamp(1.5rem,3vw,2.25rem); font-weight:400; margin:0; letter-spacing:-0.02em; line-height:1.15;">
        Join India's most trusted<br><em style="color:#821E25;">school network.</em>
      </h2>
    </div>
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
      <%= link_to contact_path, style: "display:inline-flex; align-items:center; gap:10px; background:#821E25; color:white; text-decoration:none; padding:15px 32px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; transition:background 0.2s;", onmouseover: "this.style.background='#5F1219'", onmouseout: "this.style.background='#821E25'" do %>
        Contact Us
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      <% end %>
      <%= link_to "View Services →", services_path, style: "display:inline-flex; align-items:center; gap:8px; background:transparent; color:rgba(255,255,255,0.55); text-decoration:none; padding:15px 24px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; border:1px solid rgba(255,255,255,0.12); transition:all 0.2s;", onmouseover: "this.style.borderColor='rgba(255,255,255,0.4)';this.style.color='white'", onmouseout: "this.style.borderColor='rgba(255,255,255,0.12)';this.style.color='rgba(255,255,255,0.55)'" %>
    </div>
  </div>

</div>
