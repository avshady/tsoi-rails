            <img src="assets/logos/freepress-journal.avif" alt="The Freepress Journal" width="90" height="60">
            <img src="assets/logos/toi.svg" alt="The Times of India" width="190" height="60">
            <img src="assets/logos/uni.webp" alt="UNI" width="90" height="60">
            <img src="assets/logos/sakal.webp" alt="Sakal" width="130" height="60">
          </div>
        </div>

        <form class="lead-form hero-form" id="hero-form" action="https://theschoolsofindia.org/summit/notify" method="post" data-page-section="hero">
          <div class="form-kicker">Talk to the Summit team</div>
          <h2>Request a Call Back</h2>
          <p>Leave your number and our team will call you back with everything you need to know about The Schools of India Summit 2026.</p>
          <div class="form-grid">
            <label><span>Name</span><input type="text" name="name" placeholder="Your full name" autocomplete="name" required></label>
            <label><span>Phone</span><div class="phone-field"><span>+91</span><input type="tel" name="phone" placeholder="98765 43210" autocomplete="tel" inputmode="tel" required></div></label>
            <label><span>Email</span><input type="email" name="email" placeholder="name@school.edu" autocomplete="email" required></label>
            <label><span>School</span><input type="text" name="organisation" placeholder="Your school name" autocomplete="organization" required></label>
            <label class="full"><span>Designation</span><input type="text" name="designation" placeholder="Principal, Director, Founder..." autocomplete="organization-title" required></label>
          </div>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="passId" value="registration">
          <input type="hidden" name="utm_source"><input type="hidden" name="utm_medium"><input type="hidden" name="utm_campaign"><input type="hidden" name="utm_content"><input type="hidden" name="utm_term"><input type="hidden" name="fbclid"><input type="hidden" name="li_fat_id"><input type="hidden" name="page_section" value="hero">
