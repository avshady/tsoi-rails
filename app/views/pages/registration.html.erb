  <div id="toast-message" style="position:fixed; left:50%; bottom:2rem; transform:translateX(-50%) translateY(1rem); background:#0a0a0c; color:#fff; padding:0.85rem 1.5rem; border-radius:100px; font-size:0.9rem; font-weight:600; box-shadow:0 12px 30px rgba(0,0,0,0.3); opacity:0; pointer-events:none; transition:opacity 0.3s, transform 0.3s; z-index:9999;"></div>
  <% if flash[:notice] %>
  <script>
    (function() {
      var toast = document.getElementById('toast-message');
      if (!toast) return;
      toast.textContent = "<%= j flash[:notice] %>";
      toast.style.opacity = '1';
      toast.style.transform = 'translateX(-50%) translateY(0)';
      setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(-50%) translateY(1rem)';
      }, 4000);
    })();
  </script>
  <% end %>
