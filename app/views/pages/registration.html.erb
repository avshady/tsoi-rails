  <main>
    <section class="hero section-grid" id="hero">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> 3-Day Residential Summit</div>
          <h1>The Schools of India <em>Summit 2026</em></h1>
          <p class="hero-facts"><strong>300</strong> K-12 school leaders. 3 days. Infinite Learnings.<br>Reserve your seat at <strong>TSOI Summit 2026.</strong></p>
          <p class="hero-subline">30<sup>th</sup> Oct - 1<sup>st</sup> Nov 2026 | Novotel, Imagicaa, Khopoli</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#hero-form">Request Call Back</a>
            <a class="btn btn-text track-register" href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener">Reserve Your Seat <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Speakers and advisors joining The Schools of India Summit 2026">
          <img src="assets/hero-leaders.webp" alt="TSOI Summit speakers and education leaders" width="1080" height="1080">
        </div>

        <div class="proof-strip" aria-label="Featured in">
          <span class="proof-label">Featured in</span>
