    var rem = document.createElement('button');
    rem.style.cssText = 'background:none; border:none; cursor:pointer; font-size:14px; line-height:1; color:#821E25; padding:0 0 0 6px;';
    rem.textContent = '×';
    rem.addEventListener('click', function() {
      var i = compareIds.indexOf(id); if (i > -1) compareIds.splice(i, 1);
      document.querySelectorAll('[data-cmp-id="'+id+'"]').forEach(function(b){ setCmpBtnInactive(b); });
