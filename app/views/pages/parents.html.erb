<% content_for :title, "Parents Corner — Find the Right School | The Schools of India" %>

<!-- ════════════════════════════════
     PARENTS CORNER HERO
════════════════════════════════ -->
<div class="parents-hero" style="background:#f4f0e6; padding:3rem 3rem 2.5rem; width:100%;">
  <div style="max-width:1280px; margin:0 auto; display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; flex-wrap:wrap;">
    <div>
      <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; color:#821E25; margin-bottom:1rem;">Parents Corner</div>
      <h1 style="font-family:Playfair Display,Georgia,serif; font-size:clamp(2.5rem,5vw,4rem); font-weight:700; line-height:1; letter-spacing:-0.02em; color:#1A1A1A; margin:0 0 1rem;">
        Find the <span style="color:#821E25; font-style:italic;">Right School</span><br>for your child.
      </h1>
      <p style="font-size:1rem; color:rgba(0,0,0,0.55); font-weight:300; margin:0; max-width:480px; line-height:1.7;">
        Browse <%= number_with_delimiter(@total_schools) %>+ verified schools across India. Filter by board, city, fees, and more.
      </p>
    </div>
    <div style="display:flex; gap:2.5rem; flex-wrap:wrap;">
      <div style="text-align:center;">
        <div style="font-family:Playfair Display,Georgia,serif; font-size:2rem; font-style:italic; color:#821E25; line-height:1;"><%= number_with_delimiter(@total_schools) %>+</div>
        <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.15em; color:rgba(0,0,0,0.4); margin-top:4px;">Schools</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:Playfair Display,Georgia,serif; font-size:2rem; font-style:italic; color:#821E25; line-height:1;"><%= @states.count %>+</div>
        <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.15em; color:rgba(0,0,0,0.4); margin-top:4px;">States</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:Playfair Display,Georgia,serif; font-size:2rem; font-style:italic; color:#821E25; line-height:1;">5</div>
        <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.15em; color:rgba(0,0,0,0.4); margin-top:4px;">Boards</div>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════
     SEARCH BAR
════════════════════════════════ -->
<div style="width:100%; max-width:1280px; margin:0 auto; padding:0 3rem;" class="finder-outer">

  <!-- Mobile filter toggle -->
  <div class="mobile-filter-toggle" style="display:none; margin-bottom:1rem;">
    <button onclick="toggleSidebar()" id="filterToggleBtn" style="width:100%; padding:11px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border:1px solid rgba(0,0,0,0.15); background:white; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; font-family:inherit;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
      Filters
    </button>
  </div>
  <div style="padding:1.5rem 2rem; background:white; border:1px solid rgba(0,0,0,0.1); box-shadow:0 4px 24px rgba(0,0,0,0.08); margin-top:-1px; margin-bottom:2rem; position:relative;">
    <div style="display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
      <div style="flex:1; min-width:200px;">
        <label style="display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; margin-bottom:8px; opacity:0.5;">School Name</label>
        <div style="display:flex; align-items:center; gap:10px; border-bottom:1px solid rgba(0,0,0,0.1); padding-bottom:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.4; flex-shrink:0;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="searchQ" type="text" placeholder="E.g. Delhi Public School" style="flex:1; border:none; outline:none; font-size:1.125rem; font-family:Playfair Display,Georgia,serif; background:transparent; color:#5F1219; min-width:0;" oninput="debouncedSearch()">
        </div>
      </div>
      <div style="width:1px; height:48px; background:rgba(0,0,0,0.1); flex-shrink:0; display:none;" class="md:block"></div>
      <div style="flex:1; min-width:200px;">
        <label style="display:block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; margin-bottom:8px; opacity:0.5;">City or Region</label>
        <div style="display:flex; align-items:center; gap:10px; border-bottom:1px solid rgba(0,0,0,0.1); padding-bottom:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.4; flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <select id="locationFilter" onchange="applyFilters()" style="flex:1; border:none; outline:none; font-size:1.125rem; font-family:Playfair Display,Georgia,serif; background:transparent; color:#5F1219; cursor:pointer; appearance:none; min-width:0;">
            <option value="">Anywhere in India</option>
            <optgroup label="Top Cities">
              <% @top_cities.each do |city| %>
                <option value="district:<%= city %>"><%= city %></option>
              <% end %>
            </optgroup>
            <optgroup label="Browse by State">
              <% @states.each do |s| %>
                <option value="state:<%= s %>"><%= s %></option>
              <% end %>
            </optgroup>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Two columns: sidebar + results -->
  <div style="display:flex; gap:2.5rem; align-items:flex-start; flex-wrap:wrap; padding-bottom:5rem;">

    <!-- ── SIDEBAR ── -->
    <div id="sidebarPanel" style="width:280px; flex-shrink:0; position:sticky; top:88px;" class="sidebar-wrap">
      <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(0,0,0,0.1); padding-bottom:1rem; margin-bottom:2rem;">
        <h3 style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; margin:0; display:flex; align-items:center; gap:8px;">
          <span style="display:inline-block; width:8px; height:8px; background:#821E25; border-radius:50%;"></span> Filters
        </h3>
        <button onclick="clearAllFilters()" style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; color:#821E25; background:none; border:none; cursor:pointer; font-family:inherit;" onmouseover="this.style.color='#5F1219'" onmouseout="this.style.color='#821E25'">Clear All</button>
      </div>
      <div style="margin-bottom:2rem;">
        <h4 style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; opacity:0.6; margin:0 0 1rem;">Board</h4>
        <div id="boardFilters" style="display:flex; flex-direction:column; gap:10px;">
          <div style="font-size:12px; opacity:0.4; font-style:italic;">Loading…</div>
        </div>
      </div>
      <div style="margin-bottom:2rem;">
        <h4 style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; opacity:0.6; margin:0 0 1rem;">School Type</h4>
        <div id="typeFilters" style="display:flex; flex-direction:column; gap:10px;">
          <div style="font-size:12px; opacity:0.4; font-style:italic;">Loading…</div>
        </div>
      </div>
      <div style="margin-bottom:2rem;">
        <h4 style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; opacity:0.6; margin:0 0 1rem;">Max Annual Fee</h4>
        <input type="range" id="feeSlider" min="50000" max="1500000" step="50000" value="1500000" oninput="onFeeSlider(this.value)" onchange="applyFilters()" style="width:100%; accent-color:#821E25; outline:none;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px; font-size:10px; font-family:monospace; opacity:0.6;">
          <span>₹50K</span>
          <span id="feeDisplay" style="color:#821E25; opacity:1; font-weight:700; font-size:12px; border:1px solid rgba(130,30,37,0.2); padding:2px 8px; background:rgba(130,30,37,0.05);">No Limit</span>
          <span>₹15L+</span>
        </div>
      </div>
      <div style="background:#f5f5f4; padding:1.5rem; border:1px solid rgba(0,0,0,0.05); text-align:center;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#821E25" stroke-width="1.5" style="margin:0 auto 12px; display:block;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        <h4 style="font-size:14px; font-weight:700; margin:0 0 8px;">Verified Admissions</h4>
        <p style="font-size:12px; opacity:0.7; margin:0 0 1rem; line-height:1.6;">Apply to our premium partnered schools with a single click.</p>
        <%= link_to "See Partners", partner_path, style: "font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border-bottom:1px solid #821E25; color:#821E25; padding-bottom:2px;" %>
      </div>
    </div>

    <!-- ── RESULTS ── -->
    <div style="flex:1; min-width:0;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:8px;">
        <h2 id="resultsCount" style="font-family:Playfair Display,Georgia,serif; font-size:1.25rem; color:#5F1219; margin:0;">Loading schools…</h2>
        <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; opacity:0.5;">Sorted by Relevance</div>
      </div>
      <div id="schoolCards" style="display:flex; flex-direction:column; gap:1.5rem;"></div>
      <div id="loadingState" style="display:flex; align-items:center; justify-content:center; padding:4rem; gap:12px; opacity:0.4;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <span style="font-size:13px; font-weight:600;">Loading schools…</span>
      </div>
      <div id="emptyState" style="display:none; flex-direction:column; align-items:center; padding:6rem 2rem; border:1px solid rgba(0,0,0,0.1); background:white; text-align:center;">
        <div style="width:64px; height:64px; background:#f5f5f4; border-radius:50%; display:flex; align-items:center; justify-content:center; margin-bottom:1rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.3;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <p style="font-family:Playfair Display,Georgia,serif; font-size:1.5rem; margin:0 0 0.75rem; opacity:0.4; color:#5F1219;">No institutions found.</p>
        <button onclick="clearAllFilters()" style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; border:1px solid #821E25; color:#821E25; padding:10px 24px; background:none; cursor:pointer; font-family:inherit;" onmouseover="this.style.background='#821E25';this.style.color='white'" onmouseout="this.style.background='none';this.style.color='#821E25'">Clear All Filters</button>
      </div>
      <div id="loadMoreWrap" style="display:none; text-align:center; margin-top:2rem;">
        <button onclick="loadMore()" style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; border:1px solid rgba(0,0,0,0.15); padding:14px 3rem; background:white; cursor:pointer; font-family:inherit; color:#1A1A1A;" onmouseover="this.style.borderColor='#821E25';this.style.color='#821E25'" onmouseout="this.style.borderColor='rgba(0,0,0,0.15)';this.style.color='#1A1A1A'">Load More Schools</button>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════
     COMPARE BAR (sticky bottom)
════════════════════════════════ -->
<div id="compareBar" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:80; background:#101010; border-top:2px solid #821E25; padding:14px 2rem; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; box-shadow:0 -4px 24px rgba(0,0,0,0.3);">
  <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:rgba(255,255,255,0.5); flex-shrink:0;">Comparing:</span>
    <div class="cmp-slots" style="display:flex; gap:8px; flex-wrap:wrap;"></div>
  </div>
  <div style="display:flex; gap:10px; flex-shrink:0;">
    <button onclick="openCompareModal()" style="background:#821E25; color:white; border:none; padding:10px 24px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; cursor:pointer; font-family:inherit;" onmouseover="this.style.background='#5F1219'" onmouseout="this.style.background='#821E25'">Compare Now</button>
    <button onclick="compareIds.length=0; document.querySelectorAll('[data-cmp-id]').forEach(function(b){b.style.background='white';b.style.color='#101010';b.style.borderColor='rgba(0,0,0,0.2)';b.textContent='Compare';}); renderCompareBar();" style="background:rgba(255,255,255,0.08); color:white; border:1px solid rgba(255,255,255,0.15); padding:10px 18px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; cursor:pointer; font-family:inherit;">Clear</button>
  </div>
</div>

<!-- Compare Modal -->
<div id="compareModal" style="display:none; position:fixed; inset:0; z-index:110; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); overflow-y:auto; padding:2rem 1rem;">
  <div style="max-width:1100px; margin:0 auto; background:white; position:relative;">
    <div style="display:flex; align-items:center; justify-content:space-between; padding:1.25rem 2rem; border-bottom:1px solid rgba(0,0,0,0.1); position:sticky; top:0; background:white; z-index:10;">
      <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; opacity:0.5;">School Comparison</div>
      <button onclick="closeCompareModal()" style="width:36px; height:36px; border-radius:50%; background:#f5f5f4; border:none; cursor:pointer; font-size:18px; line-height:1; display:flex; align-items:center; justify-content:center;" onmouseover="this.style.background='#e5e5e4'" onmouseout="this.style.background='#f5f5f4'">×</button>
    </div>
    <div id="compareBody" style="padding:2rem;"></div>
  </div>
</div>

<!-- ════════════════════════════════
     SCHOOL DETAIL MODAL
════════════════════════════════ -->
<div id="schoolModal" style="display:none; position:fixed; inset:0; z-index:100; background:rgba(255,255,255,0.97); backdrop-filter:blur(8px); overflow-y:auto; flex-direction:column;">
  <div style="position:sticky; top:0; background:white; border-bottom:1px solid rgba(0,0,0,0.1); padding:12px 24px; display:flex; align-items:center; justify-content:space-between; z-index:50; box-shadow:0 2px 8px rgba(0,0,0,0.06);">
    <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; opacity:0.5;">School Info Profile</div>
    <button onclick="closeModal()" style="width:36px; height:36px; border-radius:50%; background:#f5f5f4; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center;" onmouseover="this.style.background='#e5e5e4'" onmouseout="this.style.background='#f5f5f4'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div id="modalBody" style="max-width:1280px; margin:0 auto; padding:2rem 3rem 5rem; width:100%;"></div>
</div>

<style>
@keyframes fadeIn  { from { opacity:0; } to { opacity:1; } }
@keyframes spin    { to { transform:rotate(360deg); } }
@keyframes slideUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
.school-card-el:hover { border-color:rgba(130,30,37,0.4) !important; box-shadow:0 8px 32px rgba(0,0,0,0.12) !important; }
.school-card-el:hover img { transform:scale(1.05); }
.school-card-el:hover h3  { color:#821E25 !important; }
.modal-nav-btn { display:block; width:100%; text-align:left; padding:8px 12px; font-size:13px; transition:all 0.15s; border-left:2px solid transparent; background:none; border-top:none; border-right:none; border-bottom:none; cursor:pointer; font-family:inherit; color:rgba(26,26,26,0.7); }
.modal-nav-btn:hover  { color:#5F1219; background:rgba(0,0,0,0.03); }
.modal-nav-btn.active { border-left-color:#821E25; color:#821E25; font-weight:500; background:white; box-shadow:0 2px 8px rgba(0,0,0,0.06); }
@media (max-width:900px) {
  .finder-outer  { padding-left:1.25rem !important; padding-right:1.25rem !important; }
  .sidebar-wrap  { width:100% !important; position:static !important; }
}
@media (max-width:768px) {
  /* Hero */
  .parents-hero { padding:1.5rem 1.25rem 1.25rem !important; }
  .parents-hero h1 { font-size:2rem !important; }

  /* Finder search bar */
  .finder-outer > div:first-child > div { flex-direction:column !important; gap:1rem !important; }
  .finder-outer > div:first-child > div > div { min-width:0 !important; flex:unset !important; width:100% !important; }

  /* Mobile filter toggle */
  .mobile-filter-toggle { display:block !important; }

  /* Sidebar hidden by default on mobile — toggle reveals */
  #sidebarPanel { display:none; }
  #sidebarPanel.open { display:block !important; }

  /* Results full width */
  .finder-outer > div:last-child > div { flex-direction:column !important; }
  .finder-outer > div:last-child > div > div:first-child { width:100% !important; }

  /* School cards */
  .school-card-inner { flex-direction:column !important; }
  .card-img-wrap     { width:100% !important; height:200px !important; }

  /* Card stats grid: 2-col on mobile */
  .card-stats-grid   { grid-template-columns:1fr 1fr !important; }

  /* Modal */
  #modalBody { padding:1rem 1rem 4rem !important; }
  .modal-header-flex { flex-direction:column !important; }
  .modal-img-box     { width:100% !important; min-width:unset !important; }
  .modal-two-col     { flex-direction:column !important; gap:1.5rem !important; }
  .modal-nav-sidebar { display:none !important; }
  .modal-key-grid    { grid-template-columns:1fr 1fr !important; }
  .modal-academic-grid  { grid-template-columns:1fr 1fr !important; }
  .modal-hall-grid   { grid-template-columns:1fr !important; }
  .modal-facilities-grid { grid-template-columns:repeat(3,1fr) !important; }
  .modal-gallery-grid { grid-template-columns:repeat(2,1fr) !important; }
  .modal-videos-grid  { grid-template-columns:1fr !important; }
  .modal-contact-flex { flex-direction:column !important; }
}
@media (max-width:640px) {
  .school-card-inner { flex-direction:column !important; }
  .card-img-wrap     { width:100% !important; height:220px !important; }
}
</style>

<script>
var selectedBoards = [];
var selectedTypes  = [];
var maxFee         = null;
var page           = 1;
var totalPages     = 1;
var isLoading      = false;
var searchTimer    = null;
var compareIds     = [];   // max 3

document.addEventListener('DOMContentLoaded', function() {
  loadFilters();
  loadSchools(true);
});

function loadFilters() {
  fetch('/api/schools/filters')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      renderCheckboxGroup('boardFilters', data.boards, selectedBoards, function(v) {
        var idx = selectedBoards.indexOf(v);
        if (idx > -1) selectedBoards.splice(idx, 1);
        else selectedBoards.push(v);
        applyFilters();
      });
      renderCheckboxGroup('typeFilters', data.types, selectedTypes, function(v) {
        var idx = selectedTypes.indexOf(v);
        if (idx > -1) selectedTypes.splice(idx, 1);
        else selectedTypes.push(v);
        applyFilters();
      });
    });
}

function renderCheckboxGroup(containerId, items, selectedArr, onToggle) {
  var container = document.getElementById(containerId);
  container.innerHTML = '';
  items.forEach(function(item) {
    var label = document.createElement('label');
    label.style.cssText = 'display:flex; align-items:center; gap:10px; cursor:pointer; user-select:none;';
    var boxWrap = document.createElement('div');
    boxWrap.style.cssText = 'width:20px; height:20px; flex-shrink:0; display:flex; align-items:center; justify-content:center; border:1px solid rgba(0,0,0,0.25); background:white; transition:all 0.15s;';
    var checkSvg = document.createElementNS('http://www.w3.org/2000/svg','svg');
    checkSvg.setAttribute('width','11'); checkSvg.setAttribute('height','11');
    checkSvg.setAttribute('viewBox','0 0 24 24'); checkSvg.setAttribute('fill','none');
    checkSvg.setAttribute('stroke','white'); checkSvg.setAttribute('stroke-width','3');
    var poly = document.createElementNS('http://www.w3.org/2000/svg','polyline');
    poly.setAttribute('points','20 6 9 18 4 13'); checkSvg.appendChild(poly);
    checkSvg.style.display = 'none';
    boxWrap.appendChild(checkSvg);
    var span = document.createElement('span');
    span.style.cssText = 'font-size:14px; color:rgba(26,26,26,0.8); transition:color 0.15s;';
    span.textContent = item;
    label.appendChild(boxWrap); label.appendChild(span);
    function update() {
      if (selectedArr.includes(item)) {
        boxWrap.style.background = '#821E25'; boxWrap.style.borderColor = '#821E25';
        checkSvg.style.display = 'block'; span.style.color = '#5F1219'; span.style.fontWeight = '600';
      } else {
        boxWrap.style.background = 'white'; boxWrap.style.borderColor = 'rgba(0,0,0,0.25)';
        checkSvg.style.display = 'none'; span.style.color = 'rgba(26,26,26,0.8)'; span.style.fontWeight = '400';
      }
    }
    update();
    label.addEventListener('click', function() { onToggle(item); update(); });
    container.appendChild(label);
  });
}

function onFeeSlider(val) {
  val = parseInt(val);
  var display = document.getElementById('feeDisplay');
  if (val >= 1500000) { display.textContent = 'No Limit'; maxFee = null; }
  else if (val >= 100000) { display.textContent = '₹' + (val/100000).toFixed(1) + 'L'; maxFee = val; }
  else { display.textContent = '₹' + (val/1000).toFixed(0) + 'K'; maxFee = val; }
}

function debouncedSearch() { clearTimeout(searchTimer); searchTimer = setTimeout(applyFilters, 350); }
function applyFilters() { loadSchools(true); }

function clearAllFilters() {
  selectedBoards.length = 0; selectedTypes.length = 0; maxFee = null;
  document.getElementById('searchQ').value = '';
  document.getElementById('locationFilter').value = '';
  document.getElementById('feeSlider').value = '1500000';
  document.getElementById('feeDisplay').textContent = 'No Limit';
  ['boardFilters','typeFilters'].forEach(function(id) {
    var c = document.getElementById(id); if (!c) return;
    Array.from(c.querySelectorAll('label')).forEach(function(lbl) {
      var box=lbl.querySelector('div'), check=lbl.querySelector('svg'), span=lbl.querySelector('span');
      if (box)   { box.style.background='white'; box.style.borderColor='rgba(0,0,0,0.25)'; }
      if (check) { check.style.display='none'; }
      if (span)  { span.style.color='rgba(26,26,26,0.8)'; span.style.fontWeight='400'; }
    });
  });
  loadSchools(true);
}

function loadSchools(reset) {
  if (isLoading) return;
  if (reset) {
    page = 1;
    document.getElementById('schoolCards').innerHTML = '';
    document.getElementById('loadMoreWrap').style.display = 'none';
    document.getElementById('emptyState').style.display = 'none';
    document.getElementById('loadingState').style.display = 'flex';
    document.getElementById('resultsCount').textContent = 'Loading schools…';
  }
  isLoading = true;
  var params = new URLSearchParams();
  var q   = document.getElementById('searchQ').value.trim();
  var loc = document.getElementById('locationFilter').value;
  if (q) params.set('q', q);
  if (loc.indexOf('district:') === 0) params.set('district', loc.slice(9));
  else if (loc.indexOf('city:') === 0)  params.set('city',  loc.slice(5));
  else if (loc.indexOf('state:') === 0) params.set('state', loc.slice(6));
  selectedBoards.forEach(function(b) { params.append('board[]', b); });
  selectedTypes.forEach(function(t)  { params.append('type[]',  t); });
  if (maxFee) params.set('fees_max', maxFee);
  params.set('page', page); params.set('per', 24);
  fetch('/api/schools?' + params.toString())
    .then(function(r) { return r.json(); })
    .then(function(data) {
      isLoading = false; totalPages = data.pages;
      document.getElementById('loadingState').style.display = 'none';
      var count = data.total;
      document.getElementById('resultsCount').textContent = count.toLocaleString('en-IN') + ' ' + (count===1?'School':'Schools') + ' Found';
      if (data.schools.length === 0 && page === 1) { document.getElementById('emptyState').style.display = 'flex'; return; }
      var frag = document.createDocumentFragment();
      data.schools.forEach(function(s) { frag.appendChild(makeCard(s)); });
      document.getElementById('schoolCards').appendChild(frag);
      if (page < totalPages) document.getElementById('loadMoreWrap').style.display = 'block';
    })
    .catch(function() { isLoading = false; document.getElementById('loadingState').style.display = 'none'; });
}

function loadMore() { page++; loadSchools(false); }

