function renderCompareBar() {
  var bar = document.getElementById('compareBar');
  if (!bar) return;
  if (compareIds.length === 0) { bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  var slots = bar.querySelector('.cmp-slots');
  slots.innerHTML = '';
  compareIds.forEach(function(id) {
    var slot = document.createElement('div');
    slot.style.cssText = 'display:flex; align-items:center; gap:8px; background:white; border:1px solid rgba(0,0,0,0.12); padding:8px 14px; font-size:12px; font-weight:600;';
