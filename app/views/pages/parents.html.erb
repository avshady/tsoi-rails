function el(tag, attrs) {
  var e = document.createElement(tag);
  Object.keys(attrs||{}).forEach(function(k) {
    if (k==='style') e.style.cssText=attrs[k];
    else if (k==='class') e.className=attrs[k];
    else e.setAttribute(k,attrs[k]);
  });
  return e;
}

function toggleSidebar() {
  var panel = document.getElementById('sidebarPanel');
  var btn   = document.getElementById('filterToggleBtn');
  panel.classList.toggle('open');
  btn.style.borderColor = panel.classList.contains('open') ? '#821E25' : 'rgba(0,0,0,0.15)';
  btn.style.color       = panel.classList.contains('open') ? '#821E25' : 'inherit';
}

// ── Compare Modal ──
function openCompareModal() {
  if (compareIds.length < 2) { alert('Select at least 2 schools to compare.'); return; }
  var modal = document.getElementById('compareModal');
  var body  = document.getElementById('compareBody');
  modal.style.display = 'block'; document.body.style.overflow = 'hidden';
  body.innerHTML = '<div style="text-align:center;padding:3rem;opacity:0.4;">Loading…</div>';
  Promise.all(compareIds.map(function(id) {
    return fetch('/api/schools/' + id).then(function(r) { return r.json(); }).then(function(d) { return d.school; });
  })).then(function(schools) {
    var cols = schools.length;
    var grid = 'grid-template-columns:160px ' + schools.map(function(){ return '1fr'; }).join(' ');
    var fields = [
      ['Board', 'board'], ['Type', 'type'], ['City', 'city'], ['State', 'state'],
      ['Est.', 'established'], ['Grades', 'grades'], ['Fees', 'fees_display'],
      ['Student:Teacher', 'student_teacher_ratio'], ['Pass %', 'pass_percentage'],
    ];
    var html = '<div style="display:grid;' + grid + ';gap:1px;background:rgba(0,0,0,0.07);">';
    // Header row
    html += '<div style="background:#f5f5f4;padding:1rem;"></div>';
    schools.forEach(function(s) {
      html += '<div style="background:white;padding:1.25rem;text-align:center;">';
      html += '<div style="font-family:Playfair Display,Georgia,serif;font-size:1.125rem;color:#5F1219;font-weight:600;margin-bottom:4px;">' + (s.name||'—') + '</div>';
      html += '<div style="font-size:11px;color:rgba(0,0,0,0.45);">' + ([s.city,s.state].filter(Boolean).join(', ')||'—') + '</div>';
      html += '</div>';
    });
    fields.forEach(function(pair) {
      var lbl = pair[0]; var key = pair[1];
      html += '<div style="background:#f5f5f4;padding:10px 1rem;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;opacity:0.6;display:flex;align-items:center;">' + lbl + '</div>';
      schools.forEach(function(s) {
        var val = s[key]; if(!val||val==='') val = '—';
        if (key==='pass_percentage' && val !== '—') val = val + '%';
        html += '<div style="background:white;padding:10px 1rem;font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;text-align:center;">' + val + '</div>';
      });
    });
    html += '</div>';
    body.innerHTML = html;
  }).catch(function() { body.innerHTML = '<div style="padding:3rem;text-align:center;opacity:0.5;">Failed to load comparison data.</div>'; });
}
function closeCompareModal() { document.getElementById('compareModal').style.display = 'none'; document.body.style.overflow = ''; }
