<body>

  <div class="glow-blob" style="background-color: var(--color-magenta); width: 40vw; height: 40vw; top: 10%; left: -20%;"></div>
  <div class="glow-blob" style="background-color: var(--color-violet); width: 50vw; height: 50vw; top: 40%; right: -20%;"></div>
  <div class="glow-blob" style="background-color: var(--color-lime); width: 35vw; height: 35vw; bottom: 10%; left: 10%;"></div>

  <!-- Navigation -->
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/summit/assets/tsoi-summit-logo.png" alt="The Schools of India Summit" class="nav-logo-img">
      </a>
      <div class="header-actions">
        <ul class="nav-menu">
          <li><a href="#intro" class="nav-link">About</a></li>
          <li><a href="#speakers" class="nav-link">Advisory Board</a></li>
          <li><a href="#tracks" class="nav-link">Tracks</a></li>
          <li><a href="#schedule" class="nav-link">Schedule</a></li>
          <li><a href="#partners" class="nav-link">Partners</a></li>
          <li><a href="/summit/recognitions.html" class="nav-link">Recognitions 2026</a></li>
          <li><a href="#faqs" class="nav-link">FAQs</a></li>
          <li><a href="https://drive.google.com/drive/folders/1XvwMbWW6cOaji--xBDi2YsZZJVgQz6ph?usp=share_link" target="_blank" rel="noopener" class="nav-link nav-press-kit">Press Kit</a></li>
        </ul>
        <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="btn btn-primary nav-register-btn" id="nav-register-btn">Register</a>
        <button class="hamburger" aria-label="Toggle Menu" id="hamburger-btn">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Nav -->
  <div class="mobile-nav" id="mobile-nav-overlay">
    <a href="#intro" class="mobile-nav-link">About</a>
    <a href="#speakers" class="mobile-nav-link">Advisory Board</a>
    <a href="#tracks" class="mobile-nav-link">Tracks</a>
    <a href="#schedule" class="mobile-nav-link">Schedule</a>
    <a href="#partners" class="mobile-nav-link">Partners</a>
    <a href="/summit/recognitions.html" class="mobile-nav-link">Recognitions 2026</a>
    <a href="#faqs" class="mobile-nav-link">FAQs</a>
    <a href="https://drive.google.com/drive/folders/1XvwMbWW6cOaji--xBDi2YsZZJVgQz6ph?usp=share_link" target="_blank" rel="noopener" class="mobile-nav-link">Press Kit</a>
    <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="mobile-nav-link" style="color: var(--color-magenta);">Register →</a>
  </div>

  <!-- Hero -->
  <section class="hero-section" id="hero">
    <div class="hero-banner-wrap">
      <img src="/summit/assets/hero-banner.png" alt="The Schools of India Summit 2026 - 300 K-12 school leaders, 3 days, 30 Oct–1 Nov 2026, Novotel Imagicaa, Khopoli" class="hero-banner-img">
      <div class="hero-ctas">
        <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="hero-btn hero-btn-primary">
          Reserve Your Seat
          <span class="hero-btn-sub">Register Now</span>
        </a>
        <a href="/summit/recognitions.html" class="hero-btn hero-btn-secondary">
          Submit Your 5%
          <span class="hero-btn-sub">Nominate for The 5% Recognition</span>
        </a>
        <a href="#" onclick="document.getElementById('registration-dialog').showModal(); return false;" class="hero-btn hero-btn-tertiary">
          Be A Patron
          <span class="hero-btn-sub">Support the Summit</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured In -->
  <section class="featured-strip">
    <p class="featured-label">Featured in</p>
    <div class="featured-track-wrap">
      <div class="featured-track">
        <img src="/summit/assets/standard-post-logo.png" alt="Standard Post" class="featured-logo-img">
        <img src="/summit/assets/freepress-journal-logo.avif" alt="The Freepress Journal" class="featured-logo-img is-square">
        <img src="/summit/assets/toi-logo.svg" alt="Times of India" class="featured-logo-img">
        <img src="/summit/assets/uni-logo.png" alt="UNI" class="featured-logo-img is-square is-uni">
        <img src="/summit/assets/sakal-logo.jpg" alt="Sakal" class="featured-logo-img">
        <!-- duplicate set for seamless loop -->
        <img src="/summit/assets/standard-post-logo.png" alt="Standard Post" class="featured-logo-img" aria-hidden="true">
        <img src="/summit/assets/freepress-journal-logo.avif" alt="" class="featured-logo-img is-square" aria-hidden="true">
        <img src="/summit/assets/toi-logo.svg" alt="" class="featured-logo-img" aria-hidden="true">
        <img src="/summit/assets/uni-logo.png" alt="" class="featured-logo-img is-square is-uni" aria-hidden="true">
        <img src="/summit/assets/sakal-logo.jpg" alt="" class="featured-logo-img" aria-hidden="true">
      </div>
    </div>
  </section>

  <!-- Founder Section -->
  <section class="section founder-section" id="founder">
    <div class="container founder-grid">
      <div class="founder-image-col">
        <img src="/summit/assets/ankit-profile.png" alt="Ankit Pushpraj, CEO, The Schools of India" class="founder-img">
      </div>
      <div class="founder-content-col">
        <p class="founder-eyebrow">The Story behind TSOI</p>
        <h2 class="founder-heading">Every education summit forgot the one person it's for.</h2>
        <p class="founder-body">For years, India's education conferences have filled rooms with founders, principals and vendors - and left one chair empty. The student. The person every decision in that room is actually about.</p>
        <p class="founder-body">TSOI puts that right. Founders, principals, educators and the students they serve sit at the same table, in the same sessions, solving the same problems - not students as a keynote moment, but as delegates.</p>
        <blockquote class="founder-quote">
          <p>"Nobody designed education conferences to leave students out. It just happened that way, year after year."</p>
          <cite>- Ankit Pushpraj, CEO, The Schools of India</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Who TSOI Is For -->
  <section class="section" id="who-for" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="section-tag">The Room</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="who-for-title"></h2>
        <p class="who-for-lead" id="who-for-lead"></p>
      </div>
      <div class="generations-grid" id="generations-grid"></div>
      <p class="who-for-closing" id="who-for-closing"></p>
    </div>
  </section>

  <!-- Board of Advisors -->
  <section class="section" id="speakers" style="border-top: 1px solid var(--border-glow);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 1rem;">
        <span class="section-tag">Board of Advisors</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="speakers-title">The people guiding<br>the TSOI room</h2>
      </div>
      <div class="speakers-grid" id="speakers-grid">
        <% SummitSpeaker.all.order(:position).each do |sp| %>
          <div class="speaker-card sp-<%= sp.name.parameterize %>">
            <div class="speaker-img-wrapper">
              <% if sp.photo.present? %>
                <% photo_url = sp.photo.split('?').first + "?v=#{sp.updated_at.to_i}" %>
                <img src="<%= photo_url %>" alt="<%= sp.name %>" class="speaker-photo" width="280" height="280" onerror="this.style.opacity='0'">
              <% end %>
            </div>
            <div class="speaker-info">
              <h3 class="speaker-name"><%= sp.name %></h3>
              <p class="speaker-title"><%= sp.title %></p>
              <p class="speaker-org"><%= sp.organisation %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Why Attend -->
  <section class="section" id="why-attend">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="section-tag">Benefits</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="why-title">Why You Should Be Here</h2>
        <p class="why-intro-text">Not just a goodie bag. Not just an award. Six things worth carrying back to your school on Day 4.</p>
      </div>
      <div class="why-grid" id="why-grid"></div>
    </div>
  </section>

  <!-- The Flow -->
  <section class="section" id="flow" style="border-top: 1px solid var(--border-glow);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span class="section-tag">The Flow</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Three days. No filler.</h2>
      </div>
      <div class="flow-columns">
        <div class="flow-card flow-card-magenta">
          <div class="flow-ghost-num">1</div>
          <p class="flow-day flow-day-magenta">Day 0</p>
          <p class="flow-theme">Arrive & Belong</p>
          <hr class="flow-divider">
          <ul class="flow-items">
            <li class="flow-item">Arrival & Check-In</li>
            <li class="flow-item">Opening Performance</li>
            <li class="flow-item">Why We Built This</li>
            <li class="flow-item">Reflective School</li>
            <li class="flow-item">Live Music & Dinner</li>
          </ul>
        </div>
        <div class="flow-card flow-card-violet">
          <div class="flow-ghost-num">2</div>
          <p class="flow-day flow-day-violet">Day 1</p>
          <p class="flow-theme">Question Everything</p>
          <hr class="flow-divider">
          <ul class="flow-items">
            <li class="flow-item">Yoga & Breakfast</li>
            <li class="flow-item">You Can Make It Happen</li>
            <li class="flow-item">Students Take Over</li>
            <li class="flow-item">Parallel Tracks</li>
            <li class="flow-item">Every Child, Across the Range</li>
          </ul>
        </div>
        <div class="flow-card flow-card-lime">
          <div class="flow-ghost-num">3</div>
          <p class="flow-day flow-day-lime">Day 2</p>
          <p class="flow-theme">Build What's Next</p>
          <hr class="flow-divider">
          <ul class="flow-items">
            <li class="flow-item">Built by One Generation</li>
            <li class="flow-item">The Indian Classroom at a Crossroads</li>
            <li class="flow-item">The 5% Showcase</li>
            <li class="flow-item">When I Go Back...</li>
            <li class="flow-item">Closing Reflection</li>
          </ul>
        </div>
      </div>

      <!-- Participation strip -->
      <div class="flow-strip">
        <span class="flow-strip-text">LISTEN &gt; QUESTION &gt; SHARE &gt; SOLVE &gt; BUILD &gt; COMMIT</span>
      </div>

      <!-- Download CTA -->
      <div style="text-align: center; margin-top: 2rem;">
        <a href="#" id="flow-schedule-btn" class="btn btn-secondary flow-schedule-btn">Download Full Schedule</a>
      </div>
    </div>
  </section>

  <!-- Formats -->
  <section class="section" id="formats" style="border-top: 1px solid var(--border-glow);">
    <div class="container formats-split">
      <div class="formats-left">
        <span class="section-tag">The TSOI Experience</span>
        <h2 class="section-title">Participation, not content consumption.</h2>
        <p class="formats-body">Every format at the TSOI Summit puts you in a room working a real problem - not listening to one.</p>
      </div>
      <div class="format-cards-grid">
        <div class="format-card format-card-tall format-card-magenta">
          <div class="format-card-ghost">5%</div>
          <div class="format-card-content">
            <h3 class="format-card-title format-title-magenta">The 5% Sharing Sessions</h3>
            <p class="format-card-desc">Schools showcasing what works that others can copy.</p>
          </div>
        </div>
        <div class="format-card format-card-violet">
          <div class="format-card-ghost">↻</div>
          <div class="format-card-content">
            <h3 class="format-card-title">What We'd Do Differently</h3>
            <p class="format-card-desc">Experienced leaders on the decisions, systems and assumptions they'd approach differently today.</p>
          </div>
        </div>
        <div class="format-card format-card-lime">
          <div class="format-card-ghost">2035</div>
          <div class="format-card-content">
            <h3 class="format-card-title">The School of 2035</h3>
            <p class="format-card-desc">Redesigning a school from scratch, with students at the table.</p>
          </div>
        </div>
        <div class="format-card format-card-cyan">
          <div class="format-card-ghost">✦</div>
          <div class="format-card-content">
            <h3 class="format-card-title">Wellness & Networking</h3>
            <p class="format-card-desc">Yoga & mindfulness sessions along with the TSOI Gala Dinner & community launch event.</p>
          </div>
        </div>
        <div class="format-card format-card-magenta">
          <div class="format-card-ghost">⌘</div>
          <div class="format-card-content">
            <h3 class="format-card-title">Problem Rooms</h3>
            <p class="format-card-desc">Dedicated breakout sessions for next-gen founders, principals & educators.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Voices on the Stage -->
  <section class="section" id="featured-speakers-new" style="border-top: 1px solid var(--border-glow);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <span class="section-tag">Featured Speakers</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Voices on the stage.</h2>
      </div>
      <div class="speakers-list-grid">
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/lakshmi-kumar.png" alt="Dr. Lakshmi Kumar" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Dr. Lakshmi Kumar</p>
            <p class="speaker-list-role">Director - Avasara Academy</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/sanjay-malpani.png" alt="Dr. Sanjay Malpani" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Dr. Sanjay Malpani</p>
            <p class="speaker-list-role">Director - Malpani Group; Chairman - Dhruv Global School</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/parimal-merchant.png" alt="Dr. Parimal Merchant" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Dr. Parimal Merchant</p>
            <p class="speaker-list-role">Director - GFMB, SP Jain School of Global Management</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/kiran-bir-sethi.png" alt="Kiran Bir Sethi" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Kiran Bir Sethi</p>
            <p class="speaker-list-role">Founder - The Riverside High School</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/sanjay-jain.png" alt="Sanjay Jain" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Sanjay Jain</p>
            <p class="speaker-list-role">Head - Google for Education, India</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/aneesh-bangia.png" alt="Aneesh Bangia" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Aneesh Bangia</p>
            <p class="speaker-list-role">Co-founder - Open Door and Thinking Classroom</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/umes-shreshtha.png" alt="Umes Shreshtha" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Umes Shreshtha</p>
            <p class="speaker-list-role">Director - CIPL, King's College, Nepal</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/devika-nadig.png" alt="Devika Nadig" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Devika Nadig</p>
            <p class="speaker-list-role">Director - Shikshangan Education Initiatives</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/ganesh-natrajan.png" alt="Dr. Ganesh Natrajan" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Dr. Ganesh Natrajan</p>
            <p class="speaker-list-role">Former Chairman NASSCOM</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/preethi-vickram.png" alt="Preethi Vickram" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Preethi Vickram</p>
            <p class="speaker-list-role">Founder - Tapas Progressive Learning</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/swati-popat-vats.png" alt="Dr. Swati Popat Vats" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Dr. Swati Popat Vats</p>
            <p class="speaker-list-role">President - ECA & Podar Education Network</p>
          </div>
        </div>
        <div class="speaker-list-entry">
          <img src="/summit/assets/speakers/manjushree-patil.png" alt="Manjushree Patil" class="speaker-list-photo">
          <div class="speaker-list-info">
            <p class="speaker-list-name">Manjushree Patil</p>
            <p class="speaker-list-role">Founder - Director Aatman Academy</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The 5% Showcase -->
  <section class="section" id="five-percent" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container five-pct-wrap">
      <span class="section-tag">The 5% Showcase</span>
      <h2 class="section-title five-pct-headline">What's your 5%?</h2>
      <p class="five-pct-body">Every school has mastered something worth telling. Nominate yourself for The 5% Showcase and get a chance to take the Summit stage, earn recognition, and be published as a permanent case study every school in India can find and credit back to you.</p>
      <div class="five-pct-chips">
        <span class="five-pct-chip">Free to submit</span>
        <span class="five-pct-chip">10 schools take the stage</span>
        <span class="five-pct-chip">Travel & stay covered</span>
        <span class="five-pct-chip">Contributions close 3<sup>rd</sup> Oct</span>
      </div>
      <div class="five-pct-ctas">
        <a href="#" class="btn btn-secondary">See how it works</a>
        <a href="/summit/recognitions.html" class="btn btn-primary">Submit your 5%</a>
      </div>
    </div>
  </section>

  <!-- Venue -->
  <section class="section" id="venue">
    <div class="container">
      <span class="section-tag">Venue</span>
      <h2 class="section-title">A 3 day Learning Retreat At Imagicaa</h2>
      <div class="venue-grid">
        <div class="venue-info-box">
          <h3 class="venue-name" id="venue-name"></h3>
          <p class="venue-city" id="venue-city"></p>
          <div class="venue-details-list">
            <div class="venue-detail-item">
              <span class="venue-detail-icon">🚗</span>
              <div>
                <h4 class="venue-detail-title">Parking</h4>
                <p class="venue-detail-desc" id="venue-parking"></p>
              </div>
            </div>
            <div class="venue-detail-item">
              <span class="venue-detail-icon">✈️</span>
              <div>
                <h4 class="venue-detail-title">Travel Information</h4>
                <p class="venue-detail-desc" id="venue-travel"></p>
              </div>
            </div>
          </div>
        </div>
        <div class="map-container">
          <iframe
            src="https://maps.google.com/maps?q=Novotel+Imagicaa,+Khopoli,+Maharashtra&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0; display:block;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Novotel Imagicaa, Khopoli">
          </iframe>
          <div class="map-overlay-card">
            <p style="font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Novotel Imagicaa</p>
            <p style="font-size: 0.8rem; margin: 0; opacity: 0.7;">Khopoli, Maharashtra</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Schedule (disabled - re-enable for final days) -->
  <section class="section" id="schedule" style="display: none;">
    <svg class="sticker sticker-lime" style="top: 8%; right: 5%; width: 45px; height: 45px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <div class="container">
