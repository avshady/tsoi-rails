<section class="wrap section partnership-section" aria-label="Become a Partner">
<div class="partnership" id="partnership">
<div>
<p class="eyebrow">BECOME A PARTNER</p>
<h2>Be part of<br><em>what comes next.</em>
</h2>
<p>Connect your organisation with the people who build, lead and teach in Indian schools. Explore partnership opportunities with the TSOI team.</p>
<p>Tell us about your organisation. We’ll help you find the right fit.</p>
</div>
<form action="<%= summit_notify_path %>" method="post" class="enquiry-form"><%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>
<input type="hidden" name="passId" value="sponsor">
<input type="hidden" name="page_section" value="partnership">
<div class="form-grid">
<label>Full name <input name="name" autocomplete="name" required maxlength="150">
</label>
<label>Email <input type="email" name="email" autocomplete="email" required maxlength="254">
</label>
<label>Phone <input type="tel" name="phone" autocomplete="tel" required maxlength="30">
</label>
<label>School / organisation <input name="organisation" autocomplete="organization" required maxlength="200">
</label>
</div>
<label>Your role<select name="role" required>
<option value="">Select an option</option>
<option>Founder / CEO</option>
<option>Marketing / Brand</option>
<option>Partnerships / Business Development</option>
