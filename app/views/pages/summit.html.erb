<% content_for :title, "TSOI Future Schools Summit 2026" %>
<% content_for :description, "India's most powerful gathering of school leaders, educators, and education innovators. Three days. One movement." %>

<style>
@keyframes float   { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes fadeUp  { from{opacity:0;transform:translateY(32px)} to{opacity:1;transform:translateY(0)} }
@keyframes scanline{ 0%{top:-10%} 100%{top:110%} }

.summit-body { background:#060306; color:white; }

.summit-body::before {
  content:'';position:fixed;inset:0;z-index:1000;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  opacity:0.35;
}

.summit-tag {
  display:inline-block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.35em;
  color:#821E25;border:1px solid rgba(130,30,37,0.4);padding:6px 14px;margin-bottom:2rem;
  background:rgba(130,30,37,0.06);
}

.highlight-card {
  border:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02);
  padding:2rem;position:relative;overflow:hidden;transition:border-color 0.3s,background 0.3s;cursor:default;
}
.highlight-card::after {
  content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(130,30,37,0.12),transparent);
  opacity:0;transition:opacity 0.3s;
}
.highlight-card:hover { border-color:rgba(130,30,37,0.4);background:rgba(130,30,37,0.05); }
.highlight-card:hover::after { opacity:1; }

.pill-btn {
  display:inline-flex;align-items:center;gap:10px;background:#821E25;color:white;
  border:none;padding:16px 36px;font-size:11px;font-weight:700;text-transform:uppercase;
  letter-spacing:0.2em;cursor:pointer;font-family:inherit;transition:background 0.2s,transform 0.2s;
  text-decoration:none;
}
.pill-btn:hover { background:#5F1219;transform:translateY(-2px); }

.pill-btn-ghost {
  display:inline-flex;align-items:center;gap:10px;background:transparent;color:rgba(255,255,255,0.7);
  border:1px solid rgba(255,255,255,0.2);padding:16px 36px;font-size:11px;font-weight:700;
  text-transform:uppercase;letter-spacing:0.2em;cursor:pointer;font-family:inherit;
  transition:all 0.2s;text-decoration:none;
}
.pill-btn-ghost:hover { border-color:white;color:white; }

.countdown-box {
  background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);
  padding:16px 24px;text-align:center;min-width:80px;backdrop-filter:blur(8px);
}

.marquee-track { display:flex;gap:0;animation:marquee 22s linear infinite; }
.marquee-track:hover { animation-play-state:paused; }

.spk-marquee-track { display:flex;gap:0;animation:marquee 18s linear infinite; }

.speaker-card { flex-shrink:0; width:220px; overflow:hidden; position:relative; cursor:pointer; }
.speaker-card:hover .spk-img { transform:scale(1.04); }
.spk-img { transition:transform 0.5s cubic-bezier(0.16,1,0.3,1); }

@media(max-width:768px){
  .summit-highlights-grid { grid-template-columns:1fr !important; }
  .summit-who-grid { grid-template-columns:1fr 1fr !important; }
  .summit-split-flex { flex-direction:column !important; gap:2.5rem !important; }
  .hero-bottom { flex-direction:column !important; gap:2rem !important; align-items:flex-start !important; }
  .hero-headline { font-size:clamp(2.75rem,15vw,7rem) !important; }

  .summit-px { padding-left:1.25rem !important; padding-right:1.25rem !important; }
  .summit-body section[id] { padding-top:4rem !important; padding-bottom:4rem !important; }

  .summit-stats-grid { grid-template-columns:1fr 1fr !important; }
  .summit-stats-grid > div:nth-child(2) { border-right:none !important; }

  .summit-top-row { gap:1.5rem !important; }
  .summit-badge { margin-left:0 !important; font-size:8px !important; letter-spacing:0.15em !important; white-space:normal !important; }

  .countdown-box { min-width:0 !important; flex:1 1 70px; padding:10px 12px !important; }

  .summit-bottom-band { flex-direction:column !important; align-items:flex-start !important; padding:1.25rem 1.25rem !important; }

  .summit-register-card { padding:1.5rem !important; }

  .speaker-card { width:200px !important; }
  .speaker-card .session-title { font-size:10px !important; }
}
@media(max-width:480px){
  .hero-headline { font-size:clamp(2.25rem,15vw,4rem) !important; }
}
</style>

<div class="summit-body">

<!-- ══════════════════════════════════════════════
     HERO — ITconf style
══════════════════════════════════════════════ -->
<section style="position:relative; min-height:100vh; display:flex; flex-direction:column; overflow:hidden;">

  <!-- Background photo — conference audience, greyscale + brand tint -->
  <div style="position:absolute; inset:0; z-index:0;">
    <img src="/images/summit-hero.png"
         alt="" style="width:100%; height:100%; object-fit:cover; object-position:center 40%; filter:grayscale(1) blur(3px); display:block; transform:scale(1.02);">
    <!-- Dark gradient overlay -->
    <div style="position:absolute; inset:0; background:linear-gradient(to bottom, rgba(6,3,6,0.55) 0%, rgba(6,3,6,0.35) 35%, rgba(6,3,6,0.75) 70%, #060306 100%);"></div>
    <!-- Brand red tint -->
    <div style="position:absolute; inset:0; background:rgba(130,30,37,0.18);"></div>
  </div>

  <!-- Scan line -->
  <div style="position:absolute;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(130,30,37,0.6),transparent);animation:scanline 8s linear infinite;z-index:1;pointer-events:none;"></div>

  <!-- Corner accents -->
  <div style="position:absolute;top:2rem;left:2rem;width:40px;height:40px;border-top:1px solid rgba(255,255,255,0.25);border-left:1px solid rgba(255,255,255,0.25);z-index:2;"></div>
  <div style="position:absolute;top:2rem;right:2rem;width:40px;height:40px;border-top:1px solid rgba(255,255,255,0.25);border-right:1px solid rgba(255,255,255,0.25);z-index:2;"></div>

  <!-- Content -->
  <div class="summit-px" style="position:relative; z-index:5; flex:1; display:flex; flex-direction:column; padding:3rem; max-width:1400px; margin:0 auto; width:100%; box-sizing:border-box;">

    <!-- Top row: Date + Location -->
    <div class="summit-top-row" style="display:flex; gap:4rem; padding-top:1rem; margin-bottom:auto; flex-wrap:wrap;">
      <div>
        <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; color:rgba(255,255,255,0.35); margin:0 0 4px;">Date</p>
        <p style="font-size:15px; font-weight:700; color:rgba(255,255,255,0.85); margin:0; letter-spacing:0.05em;">30 Oct – 1 Nov 2026</p>
      </div>
      <div>
        <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.25em; color:rgba(255,255,255,0.35); margin:0 0 4px;">Location</p>
        <p style="font-size:15px; font-weight:700; color:rgba(255,255,255,0.85); margin:0; letter-spacing:0.05em;">Pune</p>
      </div>
      <div style="margin-left:auto;">
        <span class="summit-badge" style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.3em; color:white; border:1px solid rgba(255,255,255,0.4); padding:6px 14px; background:rgba(255,255,255,0.08); display:inline-block;">India's Premier Education Summit · 2026</span>
      </div>
    </div>

    <!-- BIG headline -->
    <div style="padding:3rem 0 2.5rem;">
      <h1 class="hero-headline" style="font-family:'Inter',sans-serif; font-size:clamp(4rem,11vw,11rem); font-weight:900; line-height:0.92; letter-spacing:-0.04em; margin:0; text-transform:uppercase; color:white;">
        Future<br>
        <span style="color:#821E25; -webkit-text-stroke:0px;">Schools</span><br>
        Summit.
      </h1>
    </div>

    <!-- Bottom row: Speakers left + Description right -->
    <div class="hero-bottom" style="display:flex; justify-content:space-between; align-items:flex-end; gap:3rem; padding-bottom:1rem; flex-wrap:wrap;">

      <!-- Left: speaker avatar placeholders + text -->
      <div>
        <!-- Avatar row -->
        <div style="display:flex; align-items:center; margin-bottom:1rem;">
          <% 3.times do |i| %>
            <div style="width:48px; height:48px; border-radius:50%; background:rgba(130,30,37,0.3); border:2px solid rgba(130,30,37,0.5); display:flex; align-items:center; justify-content:center; margin-left:<%= i==0 ? '0' : '-12px' %>; position:relative; z-index:<%= 3-i %>;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
          <% end %>
          <div style="margin-left:14px;">
            <p style="font-size:13px; font-weight:700; color:white; margin:0 0 2px;">Skilled Speakers</p>
            <div style="display:flex; align-items:center; gap:6px;">
              <span style="font-size:11px; color:rgba(255,255,255,0.4);">Announcement Coming Soon</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(130,30,37,0.8)" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </div>

        <!-- Countdown -->
        <div style="display:flex; gap:8px; flex-wrap:wrap;" id="countdown">
          <div class="countdown-box"><p style="font-family:Georgia,serif;font-size:1.5rem;margin:0;" id="cd-days">—</p><p style="font-size:8px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.4;margin:3px 0 0;">Days</p></div>
          <div class="countdown-box"><p style="font-family:Georgia,serif;font-size:1.5rem;margin:0;" id="cd-hrs">—</p><p style="font-size:8px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.4;margin:3px 0 0;">Hrs</p></div>
          <div class="countdown-box"><p style="font-family:Georgia,serif;font-size:1.5rem;margin:0;" id="cd-min">—</p><p style="font-size:8px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.4;margin:3px 0 0;">Mins</p></div>
          <div class="countdown-box"><p style="font-family:Georgia,serif;font-size:1.5rem;margin:0;" id="cd-sec">—</p><p style="font-size:8px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.4;margin:3px 0 0;">Secs</p></div>
        </div>
      </div>

      <!-- Right: description + CTA -->
      <div style="max-width:420px;">
        <h2 style="font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; color:rgba(255,255,255,0.9); margin:0 0 0.75rem;">TSOI Future Schools Summit</h2>
        <p style="font-size:14px; color:rgba(255,255,255,0.5); line-height:1.7; margin:0 0 1.5rem; font-weight:300;">
          India's most powerful gathering of school leaders, educators, and education innovators. Three days. One movement.
        </p>
        <a href="#register" class="pill-btn" style="border-radius:0;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          Reserve My Seat
        </a>
      </div>

    </div>

    <!-- Contact strip at very bottom -->
    <div style="border-top:1px solid rgba(255,255,255,0.08); margin-top:2rem; padding-top:1.25rem; display:flex; gap:3rem; flex-wrap:wrap;">
      <span style="font-size:11px; font-weight:600; letter-spacing:0.1em; color:rgba(255,255,255,0.35);">summit@theschoolsofindia.org</span>
      <span style="font-size:11px; font-weight:600; letter-spacing:0.1em; color:rgba(255,255,255,0.35);">TSOI Schools Platform</span>
    </div>

  </div>
</section>


<!-- ══════════════════════════════════════════════
     STATS BAR
══════════════════════════════════════════════ -->
<section style="background:#821E25;border-top:1px solid rgba(255,255,255,0.08);border-bottom:1px solid rgba(0,0,0,0.4);">
  <div class="summit-stats-grid" style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);">
    <% [["500+","Education Leaders"],["4","Parallel Tracks"],["30+","Live Sessions"],["3 Days","Max Impact"]].each_with_index do |(val,lbl),i| %>
      <div style="padding:2rem 1.5rem;text-align:center;<%= i<3 ? 'border-right:1px solid rgba(255,255,255,0.12);' : '' %>">
        <p style="font-family:Georgia,serif;font-size:2.25rem;margin:0 0 4px;"><%= val %></p>
        <p style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.2em;opacity:0.7;margin:0;"><%= lbl %></p>
      </div>
    <% end %>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     SPEAKERS MARQUEE (large scrolling text)
══════════════════════════════════════════════ -->
<div style="background:#821E25; padding:20px 0; overflow:hidden; border-bottom:1px solid rgba(0,0,0,0.25);">
  <div class="spk-marquee-track" style="display:flex; white-space:nowrap; width:max-content;">
    <% 3.times do %>
      <% ["SPEAKERS", "SPEAKERS", "SPEAKERS"].each do |w| %>
        <span style="font-size:clamp(2rem,5vw,4rem); font-weight:900; letter-spacing:0.05em; text-transform:uppercase; color:white; padding:0 2.5rem; opacity:0.9; font-family:'Inter',sans-serif;">
          <%= w %> <span style="opacity:0.4; margin-right:2.5rem;">✦</span>
        </span>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Dark section — fades from red into dark below speakers -->
<div style="background:linear-gradient(to bottom, #821E25 0%, #3a0d10 6%, #060306 14%);">

<!-- ══════════════════════════════════════════════
     SPEAKER CARDS
══════════════════════════════════════════════ -->
<section style="padding:5rem 0 5rem; overflow:hidden;">
  <div class="summit-px" style="padding:0 3rem; margin-bottom:2.5rem; display:flex; justify-content:space-between; align-items:flex-end; max-width:1400px; margin-left:auto; margin-right:auto;">
    <div>
      <span class="summit-tag">Speakers</span>
      <h2 style="font-family:Georgia,serif; font-size:clamp(1.75rem,3.5vw,3rem); font-weight:400; margin:0; letter-spacing:-0.02em;">First Speakers Announced</h2>
    </div>
    <p style="font-size:13px; color:rgba(255,255,255,0.35); max-width:300px; text-align:right; line-height:1.6; margin:0;">India's most influential education leaders, innovators, and policy makers.</p>
  </div>

  <!-- Horizontal scroll of speaker cards -->
  <div style="display:flex; gap:1px; padding:0 3rem; overflow-x:auto; scrollbar-width:none; -ms-overflow-style:none;" class="hide-scrollbar summit-px">
    <%
      speakers = [
        {
          role: "FAMILY-OWNED SCHOOL GROUP",
          type: "Keynote",
          name: "Anishka & Sanjay Malpani",
          session: "Keeping It in the Family: Running Schools as a Generational Business"
        },
        {
          role: "DIRECTOR, AVASARA ACADEMY",
          type: "Panel",
          name: "Laxmi Kumar",
          session: "Leadership by Design — A Panel Discussion"
        },
        { role: "EDUCATION LEADER", type: "Keynote" },
        { role: "SCHOOL PRINCIPAL", type: "Panel" },
        { role: "POLICY MAKER", type: "Keynote" },
        { role: "EDTECH INNOVATOR", type: "Workshop" },
        { role: "CURRICULUM EXPERT", type: "Panel" },
      ]
    %>
    <% speakers.each do |s| %>
      <div class="speaker-card" style="flex-shrink:0; width:240px;">
        <!-- Photo placeholder -->
        <div style="height:300px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center;">
          <!-- Subtle gradient bg -->
          <div style="position:absolute; inset:0; background:linear-gradient(135deg, rgba(130,30,37,0.12) 0%, transparent 60%);"></div>
          <!-- Silhouette icon -->
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.75" style="position:relative; z-index:1;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <!-- Bottom accent -->
          <div style="position:absolute; bottom:0; left:0; right:0; height:3px; background:linear-gradient(90deg, #821E25, rgba(130,30,37,0.3));"></div>
          <!-- Type tag -->
          <span style="position:absolute; top:12px; right:12px; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; border:1px solid rgba(130,30,37,0.4); color:rgba(130,30,37,0.9); padding:3px 8px; background:rgba(6,3,6,0.6);"><%= s[:type] %></span>
        </div>
        <!-- Info -->
        <div style="padding:1rem 0 0.5rem;">
          <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:rgba(255,255,255,0.35); margin:0 0 6px;"><%= s[:role] %></p>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">
            <p style="font-size:14px; font-weight:700; color:rgba(255,255,255,0.7); margin:0; <%= s[:name] ? '' : 'font-style:italic;' %> font-family:Georgia,serif;"><%= s[:name] || "To Be Announced" %></p>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(130,30,37,0.7)" stroke-width="2" style="flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
          <% if s[:session] %>
            <p class="session-title" style="font-size:11px; color:rgba(255,255,255,0.45); margin:8px 0 0; line-height:1.5;"><%= s[:session] %></p>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- "More coming" card -->
    <div style="flex-shrink:0; width:240px; height:300px; background:rgba(130,30,37,0.06); border:1px solid rgba(130,30,37,0.15); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem;">
      <div style="width:48px; height:48px; border:1px solid rgba(130,30,37,0.4); border-radius:50%; display:flex; align-items:center; justify-content:center;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#821E25" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <p style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:rgba(255,255,255,0.3); margin:0; text-align:center;">More Speakers<br>Reveal Aug 2026</p>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     SCROLLING MARQUEE — AGENDA ITEMS
══════════════════════════════════════════════ -->
<div style="border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);padding:18px 0;overflow:hidden;background:rgba(130,30,37,0.06);">
  <div class="marquee-track">
    <% 2.times do %>
      <% ["SOP & Systems Lab","School Shark Tank","AI Hackathon","Innovation Showcase","High-Value Networking","Keynote Clinics","Future Curriculum Forum","EdTech Sandbox"].each do |item| %>
        <span style="white-space:nowrap;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.25em;color:rgba(255,255,255,0.3);padding:0 3rem;">
          <span style="color:#821E25;margin-right:1rem;">◆</span><%= item %>
        </span>
      <% end %>
    <% end %>
  </div>
</div>


<!-- ══════════════════════════════════════════════
     STATEMENT SECTION
══════════════════════════════════════════════ -->
<section class="summit-px" style="padding:8rem 3rem; max-width:1100px; margin:0 auto;" id="about">
  <div style="display:flex; gap:6rem; align-items:center; flex-wrap:wrap;" class="summit-split-flex">
    <div style="flex:1; min-width:280px;">
      <span class="summit-tag">The Movement</span>
      <h2 style="font-family:Georgia,serif;font-size:clamp(2rem,5vw,3.75rem);font-weight:400;line-height:1.05;margin:0 0 2rem;letter-spacing:-0.02em;">
        Not a conference.<br>
        <span style="color:#821E25;font-style:italic;">A movement.</span>
      </h2>
      <p style="font-size:15px;color:rgba(255,255,255,0.5);line-height:1.9;font-weight:300;margin:0 0 1.25rem;">
        Move beyond traditional panels. Experience a community-led festival dedicated to actionable innovation, school systems, and practical implementation — built by school leaders, for school leaders.
      </p>
      <p style="font-size:15px;color:rgba(255,255,255,0.5);line-height:1.9;font-weight:300;margin:0;">
        Leave with more than inspiration. Every attendee walks away with a meaningful new connection and at least one proven system ready to deploy on Monday morning.
      </p>
    </div>

    <div style="flex:1; min-width:280px; display:flex; flex-direction:column; gap:1px; background:rgba(255,255,255,0.06);">
      <% [
        ["Build", "Walk in with a problem. Walk out with a deployed solution."],
        ["Connect", "500+ decision-makers. Structured networking that actually works."],
        ["Lead", "India's school leaders shaping the next decade of education."]
      ].each_with_index do |(title, desc), i| %>
      <div style="background:rgba(6,3,6,0.88);padding:1.75rem 2rem;display:flex;align-items:flex-start;gap:1.5rem;transition:background 0.2s;" onmouseover="this.style.background='rgba(130,30,37,0.25)'" onmouseout="this.style.background='rgba(6,3,6,0.88)'">
        <span style="font-family:Georgia,serif;font-size:2rem;color:rgba(130,30,37,0.3);font-style:italic;line-height:1;flex-shrink:0;">0<%= i+1 %></span>
        <div>
          <h3 style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;"><%= title %></h3>
