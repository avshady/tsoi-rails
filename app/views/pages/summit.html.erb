  <div class="summit-px" style="max-width:1100px;margin:0 auto;padding:8rem 3rem;position:relative;z-index:2;">
    <div style="display:flex;gap:6rem;align-items:flex-start;flex-wrap:wrap;" class="summit-split-flex">
      <div style="flex:1;min-width:280px;">
        <span class="summit-tag">Register Interest</span>
        <h2 style="font-family:Georgia,serif;font-size:clamp(2.25rem,5vw,4rem);font-weight:400;line-height:1.05;margin:0 0 1.5rem;letter-spacing:-0.03em;">
          Secure your place<br>
          <span style="color:#821E25;font-style:italic;">in the room.</span>
        </h2>
        <p style="font-size:15px;color:rgba(255,255,255,0.45);line-height:1.8;font-weight:300;max-width:420px;margin:0 0 2rem;">
          Limited seats. Be the first to know when registration opens, agenda drops, and speakers are announced.
        </p>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <% [["📍","Pune, Maharashtra"],["📅","30 Oct – 1 Nov 2026"],["👥","500 Seats — Invite Only"]].each do |icon, text| %>
