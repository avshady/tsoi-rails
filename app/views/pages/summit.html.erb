                onfocus="this.style.borderColor='rgba(130,30,37,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
            </div>
            <div style="margin-bottom:1rem;">
              <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;opacity:0.4;margin-bottom:8px;">Email Address</label>
              <input type="email" name="email" placeholder="priya@school.edu.in" required
                style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:white;padding:14px 16px;font-size:13px;font-family:inherit;outline:none;box-sizing:border-box;transition:border-color 0.2s;"
                onfocus="this.style.borderColor='rgba(130,30,37,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
            </div>
            <div style="margin-bottom:1.5rem;">
              <label style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;opacity:0.4;margin-bottom:8px;">Your Role</label>
              <select name="role"
                style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.7);padding:14px 16px;font-size:13px;font-family:inherit;outline:none;box-sizing:border-box;cursor:pointer;appearance:none;transition:border-color 0.2s;"
                onfocus="this.style.borderColor='rgba(130,30,37,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
                <option value="" style="background:#1a1a1a;">Select your role…</option>
                <option value="founder" style="background:#1a1a1a;">School Founder / Trustee</option>
                <option value="principal" style="background:#1a1a1a;">Principal / Head of School</option>
                <option value="academic" style="background:#1a1a1a;">Academic Director</option>
                <option value="edtech" style="background:#1a1a1a;">EdTech / Vendor</option>
                <option value="investor" style="background:#1a1a1a;">Investor / Funder</option>
                <option value="other" style="background:#1a1a1a;">Other</option>
