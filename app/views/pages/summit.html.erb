              <span style="font-size:14px;"><%= icon %></span>
              <span style="font-size:13px;color:rgba(255,255,255,0.5);font-weight:500;"><%= text %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div style="flex:1;min-width:280px;max-width:440px;">
        <div class="summit-register-card" style="border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.03);padding:2.5rem;backdrop-filter:blur(12px);">
          <h3 style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.2em;margin:0 0 2rem;opacity:0.5;">Join the Waitlist</h3>
          <form action="<%= summit_notify_path %>" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
