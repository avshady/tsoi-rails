        <p style="font-size:13px;color:rgba(255,255,255,0.4);margin:0;line-height:1.7;"><%= desc %></p>
      </div>
    <% end %>
  </div>
</section>


<!-- ══════════════════════════════════════════════
     WHO ATTENDS
══════════════════════════════════════════════ -->
<section class="summit-px" style="background:rgba(255,255,255,0.02);border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);padding:6rem 3rem;">
