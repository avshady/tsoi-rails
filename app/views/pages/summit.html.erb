<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Schools of India — Education Summit 2026</title>
  <meta name="description" content="Where education leaders, founders, principals, and innovators shape the future of learning. Join us for three days of bold ideas and actionable strategies.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/summit/style.css?v=11">
</head>
<body>

  <div class="glow-blob" style="background-color: var(--color-magenta); width: 40vw; height: 40vw; top: 10%; left: -20%;"></div>
  <div class="glow-blob" style="background-color: var(--color-violet); width: 50vw; height: 50vw; top: 40%; right: -20%;"></div>
  <div class="glow-blob" style="background-color: var(--color-lime); width: 35vw; height: 35vw; bottom: 10%; left: 10%;"></div>

  <!-- Navigation -->
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        THE SCHOOLS OF INDIA <span class="logo-dot"></span>
      </a>
      <div class="header-actions">
        <ul class="nav-menu">
          <li><a href="#intro" class="nav-link">About</a></li>
          <li><a href="#speakers" class="nav-link">Advisory Board</a></li>
          <li><a href="#tracks" class="nav-link">Tracks</a></li>
          <li><a href="#schedule" class="nav-link">Schedule</a></li>
          <li><a href="#partners" class="nav-link">Partners</a></li>
          <li><a href="/summit/recognitions.html" class="nav-link">Recognitions 2026</a></li>
          <li><a href="#faqs" class="nav-link">FAQs</a></li>
        </ul>
        <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="btn btn-primary nav-register-btn" id="nav-register-btn">Register</a>
        <button class="hamburger" aria-label="Toggle Menu" id="hamburger-btn">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Nav -->
  <div class="mobile-nav" id="mobile-nav-overlay">
    <a href="#intro" class="mobile-nav-link">About</a>
    <a href="#speakers" class="mobile-nav-link">Advisory Board</a>
    <a href="#tracks" class="mobile-nav-link">Tracks</a>
    <a href="#schedule" class="mobile-nav-link">Schedule</a>
    <a href="#partners" class="mobile-nav-link">Partners</a>
    <a href="/summit/recognitions.html" class="mobile-nav-link">Recognitions 2026</a>
    <a href="#faqs" class="mobile-nav-link">FAQs</a>
    <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="mobile-nav-link" style="color: var(--color-magenta);">Register →</a>
  </div>

  <!-- Hero -->
  <section class="hero-section" id="hero">
    <svg class="sticker sticker-magenta" style="top: 15%; right: 10%; width: 50px; height: 50px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <svg class="sticker sticker-lime" style="bottom: 25%; left: 5%; width: 40px; height: 40px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <div class="container hero-grid">
      <div class="hero-content">
        <h1 class="hero-headline" id="hero-headline"></h1>
        <p class="hero-subheadline" id="hero-subheadline"></p>
        <div class="hero-meta">
          <span class="hero-date" id="hero-date"></span>
          <span class="hero-location">
            <span style="color: var(--color-lime);">📍</span> <span id="hero-location-text"></span>
          </span>
        </div>
        <div class="hero-ctas">
          <a href="https://www.tezticket.com/events/TSOIS/sub_events/298" target="_blank" rel="noopener" class="btn btn-primary" id="hero-cta-primary">Register Now</a>
          <a href="#sponsor" class="btn btn-secondary" id="hero-cta-secondary">Become a Sponsor</a>
          <a href="#callback" class="btn btn-secondary" id="hero-cta-callback">Request Call Back</a>
        </div>
      </div>
      <div class="hero-art-container">
        <div class="hero-art-main">
          SHAPING<br>THE<br>FUTURE
        </div>
        <div class="hero-art-overlay">
          <div class="hero-badge">
            <p style="font-weight:800; font-size:1.1rem; color:var(--text-white);">SUMMIT 2026</p>
            <p style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--color-cyan);">Khopoli, Maharashtra</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="section" id="intro" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div class="intro-text-block">
        <span class="section-tag">Introduction</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="intro-title"></h2>
        <p class="intro-lead" id="intro-p1"></p>
        <p class="intro-sub" id="intro-p2"></p>
      </div>
    </div>
  </section>

  <!-- Who TSOI Is For -->
  <section class="section" id="who-for" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="section-tag">The Room</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="who-for-title"></h2>
        <p class="who-for-lead" id="who-for-lead"></p>
      </div>
      <div class="generations-grid" id="generations-grid"></div>
      <p class="who-for-closing" id="who-for-closing"></p>
    </div>
  </section>

  <!-- Why Attend -->
  <section class="section" id="why-attend">
    <div class="container">
      <span class="section-tag">Benefits</span>
      <h2 class="section-title" id="why-title">Why You Should Be Here</h2>
      <div class="why-grid" id="why-grid"></div>
    </div>
  </section>

  <!-- Who Should Attend -->
  <section class="section" id="who-attend" style="background-color: rgba(0,0,0,0.02); border-top: 1px solid var(--border-glow); border-bottom: 1px solid var(--border-glow);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="section-tag">Delegates</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Designed for Every Education Leader</h2>
      </div>
      <div class="who-grid" id="who-grid"></div>
    </div>
  </section>

  <!-- Content Tracks -->
  <section class="section" id="tracks" style="border-top: 1px solid var(--border-glow);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="section-tag">Choose Your Room</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="tracks-title"></h2>
        <p class="tracks-lead" id="tracks-lead"></p>
      </div>
      <div class="tracks-grid" id="tracks-grid"></div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section" id="experience">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="section-tag">The Flow</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="experience-title"></h2>
      </div>
      <div class="experience-timeline" id="experience-timeline"></div>
    </div>
  </section>

  <!-- Themes -->
  <section class="section" id="themes" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <span class="section-tag">Pillars</span>
      <h2 class="section-title">What We'll Explore</h2>
      <div class="themes-grid" id="themes-grid"></div>
    </div>
  </section>

  <!-- Speakers -->
  <section class="section" id="speakers">
    <svg class="sticker sticker-violet" style="top: 10%; left: 5%; width: 45px; height: 45px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <div class="container">
      <span class="section-tag">Visionaries</span>
      <h2 class="section-title" id="speakers-title">Board of Advisors</h2>
      <div class="speakers-grid" id="speakers-grid">
        <% SummitSpeaker.all.each do |sp| %>
          <div class="speaker-card">
            <div class="speaker-img-wrapper">
              <div class="speaker-bg-accent" style="background-color:<%= sp.accent_color %>;"></div>
              <% if sp.photo.present? %>
                <% photo_url = sp.photo.split('?').first + "?v=#{sp.updated_at.to_i}" %>
                <img src="<%= photo_url %>" alt="<%= sp.name %>" class="speaker-photo" width="280" height="280" onerror="this.style.opacity='0'">
              <% end %>
            </div>
            <div class="speaker-info">
              <h3 class="speaker-name"><%= sp.name %></h3>
              <p class="speaker-title"><%= sp.title %></p>
              <p class="speaker-org"><%= sp.organisation %></p>
            </div>
          </div>
        <% end %>
      </div>
      <div class="speakers-footer">
        <p class="speakers-soon-text" id="speakers-soon-text">More speakers being confirmed — check back soon.</p>
      </div>
    </div>
  </section>

  <!-- Featured Speakers -->
  <section class="section" id="featured-speakers" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="section-tag">Featured Speakers</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;" id="featured-speakers-title"></h2>
        <p class="featured-speakers-lead" id="featured-speakers-lead"></p>
      </div>
      <div class="featured-speakers-grid" id="featured-speakers-grid"></div>
      <p class="featured-speakers-closing" id="featured-speakers-closing"></p>
    </div>
  </section>

  <!-- Sessions -->
  <section class="section" id="sessions" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <span class="section-tag">Formats</span>
      <h2 class="section-title">Signature TSOI Formats</h2>
      <div class="sessions-grid" id="sessions-grid"></div>
    </div>
  </section>

<!-- Networking & Showcase -->
  <section class="section" id="networking-showcase" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div class="feature-split">
        <div>
          <span class="section-tag">Connections</span>
          <h2 class="section-title" style="font-size: 2.25rem; margin-bottom: 2rem;">Connections That Last Beyond Three Days</h2>
          <div class="net-grid" id="net-grid"></div>
        </div>
        <div>
          <span class="section-tag">Exhibition</span>
          <h2 class="section-title" style="font-size: 2.25rem; margin-bottom: 2rem;">Explore the Future of Education</h2>
          <div class="showcase-grid" id="showcase-grid"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Venue -->
  <section class="section" id="venue">
    <div class="container">
      <span class="section-tag">Venue</span>
      <h2 class="section-title">A World-Class Venue for Education Leaders</h2>
      <div class="venue-grid">
        <div class="venue-info-box">
          <h3 class="venue-name" id="venue-name"></h3>
          <p class="venue-city" id="venue-city"></p>
          <div class="venue-details-list">
            <div class="venue-detail-item">
              <span class="venue-detail-icon">🚗</span>
              <div>
                <h4 class="venue-detail-title">Parking</h4>
                <p class="venue-detail-desc" id="venue-parking"></p>
              </div>
            </div>
            <div class="venue-detail-item">
              <span class="venue-detail-icon">🏨</span>
              <div>
                <h4 class="venue-detail-title">Nearby Hotels</h4>
                <p class="venue-detail-desc" id="venue-hotels"></p>
              </div>
            </div>
            <div class="venue-detail-item">
              <span class="venue-detail-icon">✈️</span>
              <div>
                <h4 class="venue-detail-title">Travel Information</h4>
                <p class="venue-detail-desc" id="venue-travel"></p>
              </div>
            </div>
          </div>
        </div>
        <div class="map-container">
          <iframe
            src="https://maps.google.com/maps?q=Novotel+Imagicaa,+Khopoli,+Maharashtra&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0; display:block;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Novotel Imagicaa, Khopoli">
          </iframe>
          <div class="map-overlay-card">
            <p style="font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Novotel Imagicaa</p>
            <p style="font-size: 0.8rem; margin: 0; opacity: 0.7;">Khopoli, Maharashtra</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Schedule -->
  <section class="section" id="schedule" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <svg class="sticker sticker-lime" style="top: 8%; right: 5%; width: 45px; height: 45px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <div class="container">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="section-tag">Timetable</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Event Schedule</h2>
        <div class="schedule-flow" aria-label="Event flow">
          <span>LISTEN</span><span class="schedule-flow-arrow">→</span><span>QUESTION</span><span class="schedule-flow-arrow">→</span><span>CHOOSE</span><span class="schedule-flow-arrow">→</span><span>SHARE</span><span class="schedule-flow-arrow">→</span><span>SOLVE</span><span class="schedule-flow-arrow">→</span><span>PLAY</span><span class="schedule-flow-arrow">→</span><span>BUILD</span><span class="schedule-flow-arrow">→</span><span>COMMIT</span>
        </div>
      </div>
      <div class="schedule-container">
        <div class="schedule-tabs">
          <button class="schedule-tab is-active" data-day="Day1">30 Oct <span class="schedule-tab-theme">Arrive & Belong</span></button>
          <button class="schedule-tab" data-day="Day2">31 Oct <span class="schedule-tab-theme">Question Everything</span></button>
          <button class="schedule-tab" data-day="Day3">1 Nov <span class="schedule-tab-theme">Build What's Next</span></button>
        </div>
        <div class="schedule-list" id="schedule-list"></div>
      </div>
      <div style="text-align:center; margin-top:2.5rem;">
        <a href="#callback" id="schedule-cta-callback" class="btn btn-secondary" style="font-size:0.9rem;">Download Full Schedule ↓</a>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="section" id="partners">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3rem;">
        <span class="section-tag">Partners</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Our Partners</h2>
      </div>
      <div class="partners-grid">
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src="/summit/assets/partners/edumojo.png" alt="Edu Mojo" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <span class="partner-logo-fallback" style="display:none;">Edu Mojo</span>
          </div>
          <div class="partner-role">Technology Partner</div>
        </div>
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src="/summit/assets/partners/stockpaperscissors.png" alt="Stock Paper Scissors" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <span class="partner-logo-fallback" style="display:none;">Stock. Paper. Scissors.</span>
          </div>
          <div class="partner-role">Merchandise Partner</div>
        </div>
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src="/summit/assets/partners/tezticket.png" alt="TezTicket" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <span class="partner-logo-fallback" style="display:none;">TezTicket</span>
          </div>
          <div class="partner-role">Ticketing Partner</div>
        </div>
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src="/summit/assets/partners/gameplan.png" alt="Game Plan" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <span class="partner-logo-fallback" style="display:none;">Game Plan</span>
          </div>
          <div class="partner-role">Fitness Partner</div>
        </div>
        <div class="partner-card">
          <div class="partner-logo-wrap">
            <img src="/summit/assets/partners/bloomed.png" alt="bloomed" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <span class="partner-logo-fallback" style="display:none;">bloomed</span>
          </div>
          <div class="partner-role">Knowledge Partner</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section" id="faqs" style="border-top: 1px solid var(--border-glow); background-color: rgba(0,0,0,0.02);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="section-tag">Assistance</span>
        <h2 class="section-title" style="margin-left: auto; margin-right: auto;">Frequently Asked Questions</h2>
      </div>
      <div class="faqs-container" id="faqs-container"></div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="section" id="cta-banner" style="padding-top: 2rem;">
    <svg class="sticker sticker-cyan" style="top: 10%; left: 5%; width: 40px; height: 40px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <svg class="sticker sticker-magenta" style="bottom: 10%; right: 5%; width: 35px; height: 35px;" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0c1.5 5 5 8.5 12 12-7 1.5-10.5 5-12 12-1.5-7-5-10.5-12-12 7-1.5 10.5-5 12-12z"/>
    </svg>
    <div class="container">
      <div class="cta-banner">
        <h2 class="cta-banner-title" id="cta-banner-title"></h2>
        <p class="cta-banner-sub" id="cta-banner-sub"></p>
        <p class="cta-banner-dates" id="cta-banner-dates"></p>
        <div class="cta-banner-buttons">
          <a href="#registration" class="btn btn-primary" id="cta-banner-primary"></a>
          <a href="#partners" class="btn btn-secondary" id="cta-banner-secondary"></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="section" id="footer" style="background-color: #f0f0f5; border-top: 1px solid var(--border-glow); padding-bottom: 2rem;">
    <div class="container">
      <div class="footer-top">
        <div class="footer-about">
          <div class="footer-logo">
            THE SCHOOLS OF INDIA <span class="logo-dot"></span>
          </div>
          <p id="footer-about-text"></p>
        </div>
        <div class="footer-contact">
          <h4 class="footer-contact-title">Contact</h4>
          <ul class="footer-contact-list">
            <li>📧 <span id="footer-email"></span></li>
            <li>📞 <span id="footer-phone"></span></li>
            <li>📍 <span id="footer-address"></span></li>
          </ul>
        </div>
        <div class="footer-newsletter">
          <h4 class="footer-newsletter-title">Stay Updated</h4>
          <p class="footer-newsletter-desc">Subscribe to receive the latest updates, session releases, and speaker announcements.</p>
          <form class="newsletter-form" id="newsletter-form" action="<%= summit_notify_path %>" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input type="hidden" name="role" value="Newsletter Subscriber">
            <input type="email" name="email" placeholder="Your work email address" class="newsletter-input" required aria-label="Work Email Address">
            <button type="submit" class="btn btn-primary newsletter-submit">Subscribe</button>
          </form>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 The Schools of India. All rights reserved.</p>
        <div style="display:flex; flex-direction:column; gap:1.5rem; align-items:flex-end;">
          <ul class="footer-bottom-links" id="footer-links"></ul>
          <div class="footer-socials" id="footer-socials"></div>
        </div>
      </div>
    </div>
  </footer>

  <!-- Sponsorship Enquiry Modal -->
  <dialog id="registration-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Become a Sponsor</h3>
      <button class="modal-close-btn" id="modal-close-btn" aria-label="Close dialog">✕</button>
    </div>
    <form class="modal-form" id="modal-form" action="<%= summit_notify_path %>" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" id="form-pass-id" name="passId" value="sponsor">
      <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        Tell us about your organisation and our partnerships team will be in touch with sponsorship &amp; partnership
        opportunities for The Schools of India Summit 2026.
      </p>
      <div class="form-group">
        <label class="form-label" for="form-fullname">Full Name *</label>
        <input type="text" id="form-fullname" name="name" class="form-input" placeholder="Enter your full name" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="form-email">Email Address *</label>
        <input type="email" id="form-email" name="email" class="form-input" placeholder="name@company.com" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="form-phone">Phone Number *</label>
        <input type="tel" id="form-phone" name="phone" class="form-input" placeholder="+91 98765 43210" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="form-organisation">Company / Organisation *</label>
        <input type="text" id="form-organisation" name="organisation" class="form-input" placeholder="e.g. Acme Corporation" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="form-role">Your Role *</label>
        <select id="form-role" name="role" class="form-select" required>
          <option value="" disabled selected>Select your role</option>
          <option value="Founder / CEO">Founder / CEO</option>
          <option value="Marketing / Brand">Marketing / Brand</option>
          <option value="Partnerships / Business Development">Partnerships / Business Development</option>
          <option value="Sales">Sales</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary modal-submit-btn">Submit Enquiry</button>
    </form>
  </dialog>

  <!-- Request a Call Back Modal -->
  <dialog id="callback-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Request a Call Back</h3>
      <button class="modal-close-btn" id="callback-close-btn" aria-label="Close dialog">✕</button>
    </div>
    <form class="modal-form" id="callback-form" action="<%= summit_notify_path %>" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="passId" value="callback">
      <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        Leave your number and our team will call you back with everything you need to know about
        The Schools of India Summit 2026.
      </p>
      <div class="form-group">
        <label class="form-label" for="callback-fullname">Full Name *</label>
        <input type="text" id="callback-fullname" name="name" class="form-input" placeholder="Enter your full name" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="callback-phone">Phone Number *</label>
        <input type="tel" id="callback-phone" name="phone" class="form-input" placeholder="+91 98765 43210" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="callback-email">Email Address</label>
        <input type="email" id="callback-email" name="email" class="form-input" placeholder="name@school.edu (optional)">
      </div>
      <button type="submit" class="btn btn-primary modal-submit-btn">Request Call Back</button>
    </form>
  </dialog>

  <% if Rails.env.development? %>
  <button class="cms-panel-btn" id="cms-toggle-btn" aria-label="Open CMS Panel">⚙</button>
  <div class="cms-drawer" id="cms-drawer">
    <div class="cms-drawer-header">
      <h3 class="cms-drawer-title">
        <span class="cms-drawer-title-dot"></span> CMS Live Editor
      </h3>
      <button class="cms-drawer-close" id="cms-drawer-close" aria-label="Close CMS Panel">✕</button>
    </div>
    <div class="cms-drawer-body"></div>
    <div class="cms-drawer-footer">
      <button class="cms-btn cms-btn-reset" id="cms-reset-btn">Reset Data</button>
      <button class="cms-btn cms-btn-copy" id="cms-copy-btn">Export CMS JSON</button>
    </div>
  </div>
  <% end %>

  <div class="toast-msg" id="toast-message">Registered!</div>

  <script type="module" src="/summit/app.js?v=14"></script>
  <% if Rails.env.development? %>
  <script type="module" src="/summit/cms-editor.js"></script>
  <% end %>

  <script>
    // Hamburger menu
    var hamburger = document.getElementById('hamburger-btn');
    var mobileNav = document.getElementById('mobile-nav-overlay');
    if (hamburger && mobileNav) {
      hamburger.addEventListener('click', function() {
        hamburger.classList.toggle('is-active');
        mobileNav.classList.toggle('is-active');
      });
      mobileNav.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          hamburger.classList.remove('is-active');
          mobileNav.classList.remove('is-active');
        });
      });
    }

    // Show header CTA on scroll
    var headerCta = document.getElementById('header-cta');
    if (headerCta) {
      window.addEventListener('scroll', function() {
        headerCta.style.display = window.scrollY > 400 ? 'inline-flex' : 'none';
      });
    }

    // Sponsor enquiry modal close
    var dialog = document.getElementById('registration-dialog');
    var modalCloseBtn = document.getElementById('modal-close-btn');
    if (modalCloseBtn && dialog) {
      modalCloseBtn.addEventListener('click', function() { dialog.close(); });
      dialog.addEventListener('click', function(e) { if (e.target === dialog) dialog.close(); });
    }

    // "Become a Sponsor" CTAs open the sponsorship enquiry form
    ['hero-cta-secondary', 'cta-banner-secondary'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el && dialog) {
        el.addEventListener('click', function(e) {
          e.preventDefault();
          dialog.showModal();
        });
      }
    });

    // Request a Call Back modal
    var callbackDialog = document.getElementById('callback-dialog');
    var callbackCloseBtn = document.getElementById('callback-close-btn');
    if (callbackCloseBtn && callbackDialog) {
      callbackCloseBtn.addEventListener('click', function() { callbackDialog.close(); });
      callbackDialog.addEventListener('click', function(e) { if (e.target === callbackDialog) callbackDialog.close(); });
    }
    var callbackTriggers = document.querySelectorAll('#hero-cta-callback, #schedule-cta-callback');
    if (callbackTriggers.length && callbackDialog) {
      callbackTriggers.forEach(function(trigger) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          callbackDialog.showModal();
        });
      });
    }


    // Schedule tabs
    document.querySelectorAll('.schedule-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.schedule-tab').forEach(function(t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        if (window.renderSchedule) window.renderSchedule(window.currentCmsData.schedule, tab.dataset.day);
      });
    });

    <% if flash[:notice] %>
    var toast = document.getElementById('toast-message');
    if (toast) {
      toast.textContent = "<%= j flash[:notice] %>";
      toast.classList.add('is-visible');
      setTimeout(function() { toast.classList.remove('is-visible'); }, 4000);
    }
    <% end %>
  </script>
</body>
</html>
