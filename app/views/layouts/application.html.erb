<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "The Schools of India" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <meta name="description" content="<%= content_for(:description).presence || "India's premier school discovery and education services platform." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: '#821E25',
              'brand-dark': '#5F1219',
            },
            fontFamily: {
              serif: ['Georgia', 'serif'],
              sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <style>
      body { background-color: #FAF9F6; color: #1A1A1A; font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
      * { box-sizing: border-box; }
      a { text-decoration: none; color: inherit; }
      html { scroll-behavior: smooth; }
      /* range input accent */
      input[type=range] { accent-color: #821E25; }
      /* hide scrollbar for section nav */
      .hide-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
      .hide-scrollbar::-webkit-scrollbar { display: none; }
    </style>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col overflow-x-hidden">

    <!-- NAVBAR -->
    <nav class="flex justify-between items-center px-6 md:px-12 py-6 border-b border-black/10 bg-white sticky top-0 z-50">
      <%= link_to root_path, class: "flex items-center flex-shrink-0" do %>
        <img src="/logo.png" alt="The Schools of India" style="height:52px; width:auto; display:block;">
      <% end %>

      <!-- Desktop nav -->
      <div class="hidden md:flex gap-8 items-center" style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em;" id="desktopNav">
        <%= link_to "About", about_path, style: "color:#1A1A1A; transition:color 0.15s;", onmouseover: "this.style.color='#821E25'", onmouseout: "this.style.color='#1A1A1A'" %>
        <span style="display:inline-flex; align-items:center; gap:6px;">
          <%= link_to "Summit", summit_path, style: "color:#1A1A1A; transition:color 0.15s;", onmouseover: "this.style.color='#821E25'", onmouseout: "this.style.color='#1A1A1A'" %>
          <span style="background:#821E25; color:white; font-size:7px; font-weight:700; padding:2px 5px; letter-spacing:0.1em;">NEW</span>
        </span>
        <%= link_to "Services", services_path, style: "color:#1A1A1A; transition:color 0.15s;", onmouseover: "this.style.color='#821E25'", onmouseout: "this.style.color='#1A1A1A'" %>
        <%= link_to "Join Platform", partner_path, style: "color:#821E25; transition:color 0.15s;", onmouseover: "this.style.color='#5F1219'", onmouseout: "this.style.color='#821E25'" %>
      </div>

      <!-- Mobile hamburger -->
      <button id="navToggle" class="md:hidden" style="background:none; border:none; cursor:pointer; padding:4px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </nav>

    <!-- Mobile menu -->
    <div id="mobileMenu" style="display:none; position:fixed; top:73px; left:0; right:0; background:white; border-bottom:1px solid rgba(0,0,0,0.1); z-index:49; padding:0.5rem 1.5rem; flex-direction:column;">
      <%= link_to "About", about_path, style: "display:block; padding:12px 0; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; border-bottom:1px solid rgba(0,0,0,0.05); color:#1A1A1A;" %>
      <%= link_to "Summit", summit_path, style: "display:block; padding:12px 0; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; border-bottom:1px solid rgba(0,0,0,0.05); color:#1A1A1A;" %>
      <%= link_to "Services", services_path, style: "display:block; padding:12px 0; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; border-bottom:1px solid rgba(0,0,0,0.05); color:#1A1A1A;" %>
      <%= link_to "Join Platform", partner_path, style: "display:block; padding:12px 0; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#821E25;" %>
    </div>

    <!-- Flash messages -->
    <% if flash[:notice].present? %>
      <div style="background:#f0fdf4; border-bottom:1px solid #bbf7d0; color:#166534; padding:12px 3rem; font-size:13px; font-weight:600;">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert].present? %>
      <div style="background:#fef2f2; border-bottom:1px solid #fecaca; color:#991b1b; padding:12px 3rem; font-size:13px; font-weight:600;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- Main content -->
    <main style="flex:1; display:flex; flex-direction:column; width:100%;">
      <%= yield %>
    </main>

    <!-- FOOTER -->
    <footer style="background:white; border-top:1px solid rgba(0,0,0,0.1); padding:2.5rem 3rem;">
      <div style="max-width:1280px; margin:0 auto; display:flex; flex-direction:column; gap:2rem;" class="md:flex-row md:justify-between md:items-center">
        <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; opacity:0.5; color:#1A1A1A; line-height:1.8;">
          © <%= Time.now.year %> The Schools of India<br>
          <span style="opacity:0.7; text-transform:none; letter-spacing:normal; font-size:12px; font-weight:400;">The School Behind The Schools.</span>
        </div>
        <div style="display:flex; gap:2rem; flex-wrap:wrap; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; opacity:0.5; color:#1A1A1A;">
          <%= link_to "About Us", about_path, style: "color:inherit;" %>
          <%= link_to "Contact", contact_path, style: "color:inherit;" %>
          <%= link_to "Partner With Us", partner_path, style: "color:inherit;" %>
          <%= link_to "Certification", recognition_path, style: "color:inherit;" %>
          <%= link_to "Privacy", privacy_path, style: "color:inherit;" %>
          <%= link_to "Terms", terms_path, style: "color:inherit;" %>
        </div>
      </div>
    </footer>

    <script>
      // Mobile nav toggle
      (function() {
        var toggle = document.getElementById('navToggle');
        var menu = document.getElementById('mobileMenu');
        toggle.addEventListener('click', function() {
          menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
        });
        window.addEventListener('resize', function() {
          if (window.innerWidth >= 768) menu.style.display = 'none';
        });
      })();
    </script>
  </body>
</html>
