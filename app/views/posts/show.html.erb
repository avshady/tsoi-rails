<% content_for :title, @post.seo_title %>
<% content_for :description, @post.seo_description %>
<% content_for :head do %>
  <link rel="canonical" href="<%= @post.canonical_url %>">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="The Schools of India">
  <meta property="og:title" content="<%= @post.meta_title.presence || @post.title %>">
  <meta property="og:description" content="<%= @post.seo_description %>">
  <meta property="og:url" content="<%= @post.canonical_url %>">
  <% if @post.cover_image_url %>
    <meta property="og:image" content="<%= @post.cover_image_url %>">
    <meta property="og:image:alt" content="<%= @post.cover_image_alt.presence || @post.title %>">
    <meta name="twitter:card" content="summary_large_image">
  <% end %>
  <%= post_json_ld_tag(@post) %>
<% end %>

<style>
  body { background:#f4f0e6 !important; }
  .article-body p { font-size:1.15rem; line-height:1.85; color:rgba(0,0,0,0.72); font-weight:300; margin:0 0 1.6rem; }
  .article-body p:first-of-type { font-size:1.3rem; color:rgba(0,0,0,0.8); line-height:1.7; }
  .article-body h2 { font-family:'Playfair Display',Georgia,serif; font-size:1.85rem; line-height:1.25; color:#1A1A1A; font-weight:700; letter-spacing:-0.02em; margin:3rem 0 1.25rem; }
  .article-body h3 { font-size:1.3rem; line-height:1.35; color:#1A1A1A; font-weight:700; margin:2.25rem 0 1rem; }
  .article-body a { color:#821E25; text-decoration:underline; text-underline-offset:3px; }
  .article-body strong { font-weight:600; color:rgba(0,0,0,0.85); }
  .article-body ul, .article-body ol { font-size:1.15rem; line-height:1.85; color:rgba(0,0,0,0.72); font-weight:300; margin:0 0 1.6rem; padding-left:1.5rem; }
  .article-body ul { list-style:disc; }
  .article-body ol { list-style:decimal; }
  .article-body li { margin-bottom:0.4rem; }
  .article-body img { display:block; max-width:100%; height:auto; margin:2.5rem auto; border-radius:4px; }
  .article-body .table-wrap { overflow-x:auto; margin:0 0 2rem; }
  .article-body table { width:100%; border-collapse:collapse; font-size:1rem; background:white; border:1px solid rgba(130,30,37,0.25); }
  .article-body th, .article-body td { text-align:left; padding:0.85rem 1rem; border-bottom:1px solid rgba(0,0,0,0.08); vertical-align:top; }
  .article-body th { background:#821E25; color:white; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; }
  .article-body blockquote { border-left:3px solid #821E25; margin:0 0 1.6rem; padding:0.25rem 0 0.25rem 1.25rem; font-style:italic; }
  .related-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; }
  .related-card:hover .related-title { color:#821E25; }
  .related-title { transition:color 0.2s; }
  @media (max-width: 900px) { .related-grid { grid-template-columns:1fr; gap:2rem; } }
  @media (max-width: 640px) { .article-wrap { padding-left:1.5rem !important; padding-right:1.5rem !important; } }
</style>

<!-- Article header -->
<article>
  <header class="article-wrap" style="background:#f4f0e6; padding:4rem 3rem 0; max-width:820px; margin:0 auto; width:100%;">
    <%= link_to "← Back to blog", blog_path, style:"display:inline-block; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.16em; color:rgba(0,0,0,0.4); margin-bottom:2.5rem;" %>

    <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1.25rem;">
      <%= @post.category.presence || "Article" %>
    </p>

    <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(2.2rem,4.5vw,3.6rem); line-height:1.12; color:#1A1A1A; margin:0 0 1.75rem; font-weight:700; letter-spacing:-0.03em;">
      <%= @post.title %>
    </h1>

    <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap; padding-bottom:2.5rem; border-bottom:1px solid rgba(0,0,0,0.1);">
      <p style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.14em; color:rgba(0,0,0,0.45); margin:0;">
        <%= @post.author.presence || "The Schools of India" %> &nbsp;·&nbsp; <%= @post.display_date %> &nbsp;·&nbsp; <%= @post.reading_minutes %> min read
      </p>
    </div>
  </header>

  <% if @post.cover_image.present? %>
    <div class="article-wrap" style="background:#f4f0e6; padding:2.5rem 3rem 0; max-width:820px; margin:0 auto; width:100%;">
      <div style="aspect-ratio:16/9; background:#ddd8d0; overflow:hidden; border-radius:4px;">
        <img src="<%= @post.cover_image %>" alt="<%= @post.cover_image_alt.presence || @post.title %>" style="width:100%; height:100%; object-fit:cover;" onerror="this.parentElement.style.display='none'">
      </div>
    </div>
  <% end %>

  <!-- Body -->
  <div class="article-wrap article-body" style="background:#f4f0e6; padding:3rem 3rem 4rem; max-width:820px; margin:0 auto; width:100%;">
    <% if @post.body.present? %>
      <%= post_body_html(@post) %>
    <% else %>
      <p style="opacity:0.5; font-style:italic;">This article has no content yet.</p>
    <% end %>
  </div>
</article>

<!-- CTA strip -->
<section style="background:#821E25; padding:4rem 3rem;">
  <div style="max-width:820px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap;">
    <div>
      <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:rgba(255,255,255,0.6); margin:0 0 0.6rem;">The Schools of India Summit 2026</p>
      <p style="font-family:'Playfair Display',Georgia,serif; font-size:1.6rem; color:white; margin:0; font-weight:700; line-height:1.25;">
        Where education leaders shape what comes next.
      </p>
    </div>
    <%= link_to summit_path, style: "display:inline-flex; align-items:center; gap:10px; background:white; color:#821E25; padding:15px 30px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; border-radius:100px; white-space:nowrap;" do %>
      Explore the Summit
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    <% end %>
  </div>
</section>

<% if @related.any? %>
  <!-- Related -->
  <section class="article-wrap" style="background:#f4f0e6; padding:5rem 3rem 6rem; max-width:1280px; margin:0 auto; width:100%;">
    <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 2rem;">Keep reading</p>
    <div class="related-grid">
      <% @related.each do |post| %>
        <%= link_to blog_post_path(post), class: "related-card", style: "display:block;" do %>
          <div style="aspect-ratio:16/10; background:#ddd8d0; overflow:hidden; border-radius:4px; margin-bottom:1.15rem;">
            <% if post.cover_image.present? %>
              <img src="<%= post.cover_image %>" alt="<%= post.title %>" style="width:100%; height:100%; object-fit:cover; filter:grayscale(1);" onerror="this.style.display='none'">
            <% end %>
          </div>
          <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 0.6rem;">
            <%= post.category.presence || "Article" %>
          </p>
          <h3 class="related-title" style="font-family:'Playfair Display',Georgia,serif; font-size:1.25rem; font-weight:700; line-height:1.3; color:#1A1A1A; margin:0 0 0.5rem;">
            <%= post.title %>
          </h3>
          <p style="font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.14em; color:rgba(0,0,0,0.4); margin:0;">
            <%= post.display_date %>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
