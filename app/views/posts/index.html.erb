<% content_for :title, "Blog — The Schools of India" %>
<% content_for :description, "Ideas, practice and insight for school founders, principals, teachers and parents — from The Schools of India." %>

<style>
  body { background:#f4f0e6 !important; }
  .blog-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:2.5rem 2rem; }
  .blog-hero-grid { display:grid; grid-template-columns:1.1fr 1fr; gap:4rem; align-items:center; }
  .blog-card-img { aspect-ratio:16/10; background:#ddd8d0; overflow:hidden; border-radius:4px; margin-bottom:1.25rem; }
  .blog-card-img img { width:100%; height:100%; object-fit:cover; filter:grayscale(1); transition:all 0.7s; }
  .blog-card:hover .blog-card-img img { filter:grayscale(0); transform:scale(1.04); }
  .blog-card:hover .blog-card-title { color:#821E25; }
  .blog-card-title { transition:color 0.2s; }
  @media (max-width: 1000px) {
    .blog-grid { grid-template-columns:1fr 1fr; }
    .blog-hero-grid { grid-template-columns:1fr; gap:2rem; }
  }
  @media (max-width: 640px) {
    .blog-grid { grid-template-columns:1fr; gap:2.5rem; }
    .blog-wrap { padding-left:1.5rem !important; padding-right:1.5rem !important; }
  }
</style>

<!-- Header -->
<section class="blog-wrap" style="background:#f4f0e6; padding:5rem 3rem 2.5rem; max-width:1280px; margin:0 auto; width:100%;">
  <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1.25rem;">The Blog</p>
  <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(2.5rem,5vw,4.5rem); line-height:1.08; color:#1A1A1A; margin:0 0 1.5rem; font-weight:700; letter-spacing:-0.03em;">
    Ideas from the<br>schools <em style="color:#821E25;">building India.</em>
  </h1>
  <p style="font-size:1.1rem; color:rgba(0,0,0,0.6); line-height:1.75; font-weight:300; max-width:600px; margin:0;">
    Practice, perspective and lessons learned — written for founders, principals, teachers and parents.
  </p>
</section>

<% if @categories.any? %>
  <!-- Category filter -->
  <section class="blog-wrap" style="background:#f4f0e6; padding:0 3rem 2.5rem; max-width:1280px; margin:0 auto; width:100%;">
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap; border-top:1px solid rgba(0,0,0,0.1); padding-top:1.5rem;">
      <%= link_to "All", blog_path,
            style: "padding:7px 16px; border-radius:100px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; border:1px solid #{@active_category.blank? ? '#821E25' : 'rgba(0,0,0,0.15)'}; background:#{@active_category.blank? ? '#821E25' : 'transparent'}; color:#{@active_category.blank? ? 'white' : 'rgba(0,0,0,0.6)'};" %>
      <% @categories.each do |cat| %>
        <% on = (@active_category == cat) %>
        <%= link_to cat, blog_path(category: cat),
              style: "padding:7px 16px; border-radius:100px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; border:1px solid #{on ? '#821E25' : 'rgba(0,0,0,0.15)'}; background:#{on ? '#821E25' : 'transparent'}; color:#{on ? 'white' : 'rgba(0,0,0,0.6)'};" %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @posts.any? %>
  <!-- Featured post -->
  <section class="blog-wrap" style="background:#f4f0e6; padding:1.5rem 3rem 4rem; max-width:1280px; margin:0 auto; width:100%;">
    <%= link_to blog_post_path(@featured), class: "blog-card", style: "display:block;" do %>
      <div class="blog-hero-grid">
        <div class="blog-card-img" style="aspect-ratio:16/11; margin-bottom:0;">
          <% if @featured.cover_image.present? %>
            <img src="<%= @featured.cover_image %>" alt="<%= @featured.title %>" onerror="this.style.display='none'">
          <% end %>
        </div>
        <div>
          <p style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 1rem;">
            <%= @featured.category.presence || "Featured" %>
          </p>
          <h2 class="blog-card-title" style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(1.8rem,3vw,2.8rem); font-weight:700; line-height:1.15; letter-spacing:-0.02em; color:#1A1A1A; margin:0 0 1.25rem;">
            <%= @featured.title %>
          </h2>
          <p style="font-size:1.05rem; color:rgba(0,0,0,0.6); line-height:1.75; font-weight:300; margin:0 0 1.5rem;">
            <%= @featured.summary %>
          </p>
          <p style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.14em; color:rgba(0,0,0,0.45); margin:0;">
            <%= @featured.author.presence || "The Schools of India" %> &nbsp;·&nbsp; <%= @featured.display_date %> &nbsp;·&nbsp; <%= @featured.reading_minutes %> min read
          </p>
        </div>
      </div>
    <% end %>
  </section>

  <% if @rest.any? %>
    <!-- Post grid -->
    <section class="blog-wrap" style="background:#f4f0e6; padding:0 3rem 6rem; max-width:1280px; margin:0 auto; width:100%;">
      <div style="border-top:1px solid rgba(0,0,0,0.1); padding-top:3rem;">
        <div class="blog-grid">
          <% @rest.each do |post| %>
            <%= link_to blog_post_path(post), class: "blog-card", style: "display:block;" do %>
              <div class="blog-card-img">
                <% if post.cover_image.present? %>
                  <img src="<%= post.cover_image %>" alt="<%= post.title %>" onerror="this.style.display='none'">
                <% end %>
              </div>
              <p style="font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:0.2em; color:#821E25; margin:0 0 0.75rem;">
                <%= post.category.presence || "Article" %>
              </p>
              <h3 class="blog-card-title" style="font-family:'Playfair Display',Georgia,serif; font-size:1.4rem; font-weight:700; line-height:1.25; letter-spacing:-0.01em; color:#1A1A1A; margin:0 0 0.75rem;">
                <%= post.title %>
              </h3>
              <p style="font-size:0.95rem; color:rgba(0,0,0,0.55); line-height:1.7; font-weight:300; margin:0 0 1rem;">
                <%= truncate(post.summary, length: 130) %>
              </p>
              <p style="font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.14em; color:rgba(0,0,0,0.4); margin:0;">
                <%= post.display_date %> &nbsp;·&nbsp; <%= post.reading_minutes %> min read
              </p>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
<% else %>
  <!-- Empty state -->
  <section class="blog-wrap" style="background:#f4f0e6; padding:2rem 3rem 8rem; max-width:1280px; margin:0 auto; width:100%;">
    <div style="border-top:1px solid rgba(0,0,0,0.1); padding-top:4rem; text-align:center;">
      <p style="font-family:'Playfair Display',Georgia,serif; font-size:1.8rem; color:rgba(0,0,0,0.35); margin:0 0 1rem; font-style:italic;">
        <%= @active_category.present? ? "Nothing here yet in #{@active_category}." : "The first stories are being written." %>
      </p>
      <p style="font-size:1rem; color:rgba(0,0,0,0.45); font-weight:300; margin:0 0 2rem;">
        <%= @active_category.present? ? "Try another category." : "Check back shortly — new writing is on the way." %>
      </p>
      <% if @active_category.present? %>
        <%= link_to "← All articles", blog_path, style:"color:#821E25; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.15em;" %>
      <% end %>
    </div>
  </section>
<% end %>
